          <circle cx="12" cy="12" r="9"/>
          <path d="M12 8v5"/>
          <circle cx="12" cy="16.5" r=".7" fill="currentColor"/>
        </svg>

      </div>

      <div>

        <strong>Important</strong>

        <p>
          All exchange requests are subject to approval after verification.
        </p>

      </div>

    </div>

  </section>


  <!-- RETURN POLICY -->
  <section class="dm-return-section">

    <div class="dm-return-section-head">
      <div class="dm-return-number">05</div>

      <div>
        <h2>Return Policy</h2>
        <p class="dm-return-intro">
          Returns are accepted only when the following conditions apply.
        </p>
      </div>
    </div>


    <ul class="dm-return-list">

      <li>The product arrived damaged.</li>

      <li>Items are missing from your order.</li>

      <li>
        The product remains unopened, unused, and in its original condition.
      </li>

      <li>Return requests are raised within 48 hours of delivery.</li>
      <li>The product was not purchased on sale.</li>
      <li>A clear unboxing video is provided for verification.</li>

    </ul>

