      </div>

    </div>

  </section>


  <!-- INVOICE -->
  <section class="dm-section">

    <div class="dm-section-head">

      <div class="dm-section-number">06</div>

      <div>
        <h2>Invoice Information</h2>
        <p class="dm-section-intro">
          Transparent billing with every order.
        </p>
      </div>

    </div>


    <div class="dm-invoice">

