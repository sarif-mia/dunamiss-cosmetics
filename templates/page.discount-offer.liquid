{{ 'discount-offers-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign shipping_threshold = settings.free_shipping_minimum | plus: 0
  assign shipping_threshold_money = shipping_threshold | times: 100 | money
  assign gift_threshold = settings.native_cart_gift_threshold | plus: 0
  assign gift_threshold_money = gift_threshold | times: 100 | money
  assign gift_product = settings.native_cart_gift_product
  assign gift_variant = gift_product.selected_or_first_available_variant
  assign discount_threshold = settings.native_cart_discount_threshold | plus: 0
  assign discount_threshold_money = discount_threshold | times: 100 | money
  assign discount_label = settings.native_cart_discount_label | default: 'Cart discount'
  assign shipping_enabled = false
  assign gift_enabled = false
  assign discount_enabled = false

  if settings.show_on_minicart_cart_page and shipping_threshold > 0
    assign shipping_enabled = true
  endif
  if settings.native_cart_auto_gift and gift_product != blank and gift_variant.available and gift_threshold > 0
    assign gift_enabled = true
  endif
  if settings.native_cart_discount_milestone and discount_threshold > 0
    assign discount_enabled = true
  endif
%}

<main class="dm-offers-page">
  <section class="dm-offers-hero" aria-labelledby="DmOffersTitle">
    <div class="fluid_container dm-offers-hero__grid">
      <div class="dm-offers-hero__content">
        <span class="dm-offers-eyebrow">Current cart rewards</span>
        <h1 id="DmOffersTitle">More beauty, more rewards.</h1>
        <p>
          Unlock the offers below as your qualifying cart value grows. Your progress updates automatically in the cart, so there is no code to remember.
        </p>
        <div class="dm-offers-actions">
          <a class="dm-offers-button dm-offers-button--primary" href="{{ routes.all_products_collection_url }}">Shop all products</a>
          <a class="dm-offers-button dm-offers-button--secondary" href="#current-offers">See current offers</a>
        </div>
      </div>

      <div class="dm-offers-ladder" aria-label="Current reward thresholds">
        <div class="dm-offers-ladder__heading">
          <span>Reward ladder</span>
          <small>Unlocked automatically</small>
        </div>
        <ol>
          {%- if shipping_enabled -%}
            <li>
              <span class="dm-offers-ladder__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M3.5 6.5h10v10h-10zM13.5 10h3.2l3.8 3.7v2.8h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span><small>Spend</small><strong>{{ shipping_threshold_money }}</strong></span>
              <span>Free shipping</span>
            </li>
          {%- endif -%}
          {%- if gift_enabled -%}
            <li>
              <span class="dm-offers-ladder__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 10h16v10H4zM3 6.5h18V10H3zM12 6.5V20M12 6.5H8.4a2.2 2.2 0 1 1 2.2-2.2c0 1.2 1.4 2.2 1.4 2.2Zm0 0h3.6a2.2 2.2 0 1 0-2.2-2.2c0 1.2-1.4 2.2-1.4 2.2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span><small>Spend</small><strong>{{ gift_threshold_money }}</strong></span>
              <span>Free gift</span>
            </li>
          {%- endif -%}
          {%- if discount_enabled -%}
            <li>
              <span class="dm-offers-ladder__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="m4.5 12 7.5-7.5h6.5a1 1 0 0 1 1 1V12L12 19.5 4.5 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M15.8 8.2h.01M9.2 14.8l5.6-5.6M10 10.2h.01M14 13.8h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
              <span><small>Spend</small><strong>{{ discount_threshold_money }}</strong></span>
              <span>{{ discount_label | escape }}</span>
            </li>
          {%- endif -%}
        </ol>
      </div>
    </div>
  </section>

  <section class="dm-offers-current" id="current-offers" aria-labelledby="DmCurrentOffersTitle">
    <div class="fluid_container">
      <div class="dm-offers-section-heading">
        <span class="dm-offers-eyebrow">Available now</span>
        <h2 id="DmCurrentOffersTitle">Offers that match your cart</h2>
        <p>Shop normally and watch each reward unlock in your cart.</p>
      </div>

      <div class="dm-offers-grid">
        {%- if shipping_enabled -%}
          <article class="dm-offers-card">
            <span class="dm-offers-card__number">01</span>
            <span class="dm-offers-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M3.5 6.5h10v10h-10zM13.5 10h3.2l3.8 3.7v2.8h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="dm-offers-card__tag">Shipping reward</span>
            <h3>Free shipping from {{ shipping_threshold_money }}</h3>
            <p>Reach {{ shipping_threshold_money }} in qualifying products and free shipping unlocks for your order.</p>
            <div class="dm-offers-card__footer"><span>No code required</span><strong>{{ shipping_threshold_money }}</strong></div>
          </article>
        {%- endif -%}

        {%- if gift_enabled -%}
          <article class="dm-offers-card dm-offers-card--gift">
            <span class="dm-offers-card__number">02</span>
            <div class="dm-offers-card__gift-row">
              <span class="dm-offers-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 10h16v10H4zM3 6.5h18V10H3zM12 6.5V20M12 6.5H8.4a2.2 2.2 0 1 1 2.2-2.2c0 1.2 1.4 2.2 1.4 2.2Zm0 0h3.6a2.2 2.2 0 1 0-2.2-2.2c0 1.2-1.4 2.2-1.4 2.2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {%- if gift_product.featured_image -%}
                <a class="dm-offers-card__gift-image" href="{{ gift_product.url }}" aria-label="View {{ gift_product.title | escape }}">
                  {{ gift_product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '74px', alt: gift_product.title }}
                </a>
              {%- endif -%}
            </div>
            <span class="dm-offers-card__tag">Free gift</span>
            <h3>A complimentary gift from {{ gift_threshold_money }}</h3>
            <p>{{ gift_product.title | escape }} is added automatically when your qualifying cart reaches {{ gift_threshold_money }}.</p>
            <div class="dm-offers-card__footer"><span>While stocks last</span><strong>{{ gift_threshold_money }}</strong></div>
          </article>
        {%- endif -%}

        {%- if discount_enabled -%}
          <article class="dm-offers-card">
            <span class="dm-offers-card__number">03</span>
            <span class="dm-offers-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="m4.5 12 7.5-7.5h6.5a1 1 0 0 1 1 1V12L12 19.5 4.5 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M15.8 8.2h.01M9.2 14.8l5.6-5.6M10 10.2h.01M14 13.8h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </span>
            <span class="dm-offers-card__tag">Cart saving</span>
            <h3>{{ discount_label | escape }} from {{ discount_threshold_money }}</h3>
            <p>Reach {{ discount_threshold_money }} in qualifying products to unlock {{ discount_label | escape }} on your order.</p>
            <div class="dm-offers-card__footer"><span>Applied when eligible</span><strong>{{ discount_threshold_money }}</strong></div>
          </article>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="dm-offers-info" aria-labelledby="DmOfferDetailsTitle">
    <div class="fluid_container dm-offers-info__grid">
      <div>
        <span class="dm-offers-eyebrow">Good to know</span>
        <h2 id="DmOfferDetailsTitle">Simple rewards, clearly shown.</h2>
      </div>
      <ul>
        <li>Progress is based on the qualifying cart subtotal after product discounts.</li>
        <li>The free gift is limited to one per eligible cart and depends on availability.</li>
        <li>Final eligibility, savings and shipping are confirmed in the cart and at checkout.</li>
      </ul>
    </div>
  </section>

  <section class="dm-offers-cta">
    <div class="fluid_container">
      <div class="dm-offers-cta__inner">
        <div><span>Ready to unlock your rewards?</span><h2>Build your beauty cart.</h2></div>
        <a class="dm-offers-button dm-offers-button--light" href="{{ routes.all_products_collection_url }}">Start shopping</a>
      </div>
    </div>
  </section>

</main>
