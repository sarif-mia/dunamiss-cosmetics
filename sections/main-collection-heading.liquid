{%- liquid
  assign dm_banner_block = nil
  for block in section.blocks
    if block.type == 'dm_collection_banner'
      assign banner_handle = block.settings.collection.handle | default: block.settings.handle
      if banner_handle == collection.handle
        assign dm_banner_block = block
      endif
    endif
  endfor
-%}
{{ 'dunamiss-collection-banner.css' | asset_url | stylesheet_tag }}
{% render 'dunamiss-collection-banner', collection: collection, section: section, banner_block: dm_banner_block %}
{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "page-title",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "All collection pages share this layout. Choose the collection block to edit its heading, subtitle or image. Images are stored in Shopify Files, outside the theme. The heading is the page\u2019s single H1."
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "dm_collection_banner",
      "name": "Collection banner",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Editor label",
          "default": "Collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle",
          "info": "Optional fallback for system collections such as all. A selected collection takes priority."
        },
        {
          "type": "checkbox",
          "id": "show_banner",
          "label": "Show banner image",
          "default": true,
          "info": "Turning off the image keeps the collection heading visible."
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image",
          "info": "Choose an image from Shopify Files. A wide 3:1 image works best."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Defaults to the desktop image with a responsive Shopify CDN size."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Banner heading",
          "info": "Leave blank to use the collection name or shared category heading."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Banner subtitle"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        }
      ]
    }
  ]
}
{% endschema %}
