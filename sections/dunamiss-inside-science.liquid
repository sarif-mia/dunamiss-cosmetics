<div class="{{ section.settings.section_width }}">
  {% render 'dunamiss-inside-science', product: product %}
</div>
{% schema %}
{
  "name": "Inside Science",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "select", "id": "section_width", "label": "Section width", "default": "fluid_container", "options": [
      { "value": "container", "label": "Container" },
      { "value": "fluid_container", "label": "Fluid container" }
    ] }
  ],
  "presets": [{ "name": "Inside Science" }]
}
{% endschema %}
