<style>
  .dm-terms {
    --dm-bg: var(--brand-ivory);
    --dm-card: var(--color-white);
    --dm-text: var(--brand-ink);
    --dm-muted: var(--brand-muted);
    --dm-accent: var(--brand-rose);
    --dm-accent-light: var(--brand-blush);
    --dm-border: var(--color-border);
    --dm-green: #667d63;

    max-width: 1000px;
    margin: 50px auto;
    padding: 0 20px;
    font-family: var(--body-font);
    color: var(--dm-text);
  }

  .dm-terms *,
  .dm-terms *::before,
  .dm-terms *::after {
    box-sizing: border-box;
  }

  /* HERO */
  .dm-terms .dm-hero {
    position: relative;
    overflow: hidden;
    padding: 55px 45px;
    margin-bottom: 24px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 90% 10%, rgba(155,115,88,.16), transparent 30%),
      radial-gradient(circle at 10% 90%, rgba(155,115,88,.09), transparent 35%),
      var(--brand-blush);
    border: 1px solid var(--dm-border);
  }

  .dm-terms .dm-hero::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -70px;
    bottom: -80px;
    border: 1px solid rgba(155,115,88,.18);
    border-radius: 50%;
  }

  .dm-terms .dm-hero::after {
    content: "";
    position: absolute;
    width: 110px;
    height: 110px;
    right: 20px;
    bottom: -55px;
    border: 1px solid rgba(155,115,88,.12);
    border-radius: 50%;
  }

  .dm-terms .dm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: var(--dm-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .dm-terms .dm-eyebrow svg {
    width: 16px;
    height: 16px;
  }

  .dm-terms .dm-hero h1 {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    font-family: var(--body-font);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.01em;
  }

  .dm-terms .dm-hero p {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 0;
    color: var(--dm-muted);
    font-size: 16px;
    line-height: 1.8;
  }

  /* QUICK BENEFITS */
  .dm-terms .dm-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .dm-terms .dm-benefit {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 19px;
    background: var(--dm-card);
    border: 1px solid var(--dm-border);
    border-radius: 16px;
    box-shadow: 0 5px 20px rgba(50,35,25,.04);
  }

  .dm-terms .dm-icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--dm-accent);
    background: var(--dm-accent-light);
  }

  .dm-terms .dm-icon svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
  }

  .dm-terms .dm-benefit strong {
    display: block;
    margin-bottom: 3px;
    font-size: 14px;
  }

  .dm-terms .dm-benefit span {
    color: var(--dm-muted);
    font-size: 12px;
  }

  /* CONTENT CARD */
  .dm-terms .dm-section {
    margin-bottom: 18px;
    padding: 28px;
    background: var(--dm-card);
    border: 1px solid var(--dm-border);
    border-radius: 20px;
    box-shadow: 0 5px 22px rgba(50,35,25,.035);
  }

  .dm-terms .dm-section-head {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
  }

  .dm-terms .dm-section-number {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: var(--dm-accent-light);
    color: var(--dm-accent);
    font-size: 13px;
    font-weight: 700;
  }

  .dm-terms .dm-section h2 {
    margin: 0 0 5px;
    font-family: var(--body-font);
    font-size: 23px;
    font-weight: 500;
  }

  .dm-terms .dm-section-intro {
    margin: 0;
    color: var(--dm-muted);
    font-size: 13px;
  }

  /* POLICY LIST */
  .dm-terms .dm-list {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dm-terms .dm-list li {
    position: relative;
    padding-left: 25px;
    color: var(--dm-text);
    font-size: 14px;
    line-height: 1.65;
  }

  .dm-terms .dm-list li::before {
    content: "";
    position: absolute;
    top: 9px;
    left: 4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dm-accent);
  }

  /* CONTENT GRID */
  .dm-terms .dm-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }

  .dm-terms .dm-card {
    padding: 22px;
    border-radius: 16px;
    border: 1px solid var(--dm-border);
    background: var(--brand-ivory);
  }

  .dm-terms .dm-card.accent {
    border-color: var(--dm-border);
    background: linear-gradient(145deg, var(--brand-blush), var(--color-white));
  }

  .dm-terms .dm-card h3 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 10px;
    font-size: 15px;
  }

  .dm-terms .dm-card h3 svg {
    width: 18px;
    height: 18px;
    color: var(--dm-accent);
    stroke: currentColor;
  }

  .dm-terms .dm-card p {
    margin: 0;
    color: var(--dm-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* NOTICE */
  .dm-terms .dm-notice {
    display: flex;
    gap: 14px;
    padding: 18px;
    border-radius: 14px;
    background: #f7f3ee;
  }

  .dm-terms .dm-notice-icon {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #fff;
    color: var(--dm-accent);
  }

  .dm-terms .dm-notice-icon svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
  }

  .dm-terms .dm-notice strong {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
  }

  .dm-terms .dm-notice p {
    margin: 0;
    color: var(--dm-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  /* PRIVACY BOX */
  .dm-terms .dm-privacy {
    display: flex;
    gap: 15px;
    padding: 20px;
    border: 1px solid var(--dm-border);
    border-radius: 14px;
    background: linear-gradient(135deg, var(--brand-blush), var(--brand-ivory));
  }

  .dm-terms .dm-privacy-icon {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: var(--color-white);
    color: var(--dm-accent);
  }

  .dm-terms .dm-privacy-icon svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
  }

  .dm-terms .dm-privacy h3 {
    margin: 0 0 5px;
    font-size: 14px;
  }

  .dm-terms .dm-privacy p {
    margin: 0;
    color: var(--dm-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* SUPPORT */
  .dm-terms .dm-support {
    position: relative;
    overflow: hidden;
    margin-top: 24px;
    padding: 38px 35px;
    border-radius: 22px;
    color: var(--color-white);
    background:
      radial-gradient(circle at 90% 20%, rgba(255,255,255,.12), transparent 30%),
      linear-gradient(135deg, var(--brand-ink), var(--brand-rose));
  }


  .dm-terms .dm-support h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    font-family: var(--body-font);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-white);
  }

  .dm-terms .dm-support > p {
    position: relative;
    z-index: 1;
    margin: 0 0 22px;
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
    font-size: 13px;
    line-height: 1.6;
  }

  .dm-terms .dm-contact {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dm-terms .dm-contact a,
  .dm-terms .dm-contact span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 30px;
    color: var(--color-white);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-white) 9%, transparent);
    font-size: 12px;
  }

  .dm-terms .dm-contact svg {
    width: 15px;
    height: 15px;
    stroke: currentColor;
  }

  /* FOOTER */
  .dm-terms .dm-footer {
    padding: 22px 10px 5px;
    text-align: center;
    color: var(--dm-muted);
    font-family: var(--body-font);
    font-size: 14px;
    font-style: italic;
  }

  /* RESPONSIVE */
  @media (max-width: 700px) {

    .dm-terms {
      margin: 25px auto;
      padding: 0 14px;
    }

    .dm-terms .dm-hero {
      padding: 35px 25px;
      border-radius: 20px;
    }

    .dm-terms .dm-benefits {
      grid-template-columns: 1fr;
    }

    .dm-terms .dm-section {
      padding: 22px 18px;
      border-radius: 17px;
    }

    .dm-terms .dm-grid {
      grid-template-columns: 1fr;
    }

    .dm-terms .dm-support {
      padding: 30px 22px;
    }

    .dm-terms .dm-contact {
      flex-direction: column;
      align-items: stretch;
    }

    .dm-terms .dm-contact a,
    .dm-terms .dm-contact span {
      justify-content: flex-start;
    }

    .dm-terms .dm-privacy {
      flex-direction: column;
    }
  }
</style>


