{% schema %}
{
  "name": "Dunamiss certifications",
  "tag": "section",
  "class": "dm-editable-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the content groups below. Their positions follow this page’s fixed layout. Additional sections can be added below the page."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
