<style>
/* ========== GLOBAL SECTION WRAPPER ========== */


/* ========== BANNER SECTION ========== */
.certifications-banner {
    background-image: url('{% if section.settings.background_1 != blank %}{{ section.settings.background_1 | image_url: width: 2400 }}{% else %}{{ 'certification-page-banner-image.png' | file_url }}{% endif %}');
    background-size: cover;
    background-position: center;
    padding: 120px 20px;
    text-align: center;
    color: white;
    position: relative;
}

.certifications-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 24, 20, 0.42);
    z-index: 1;
}

.banner-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.38);
}

.banner-title {
    font-size: 60px;
    font-weight: 300;
    margin-bottom: 20px;
    letter-spacing: 2px;
    color: white;
    font-family: var(--body-font);
}

.banner-subtitle {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 300;
    margin: 0;
}

/* ========== CERTIFICATION LIST SECTION ========== */
.certification-list-section {
    padding: 84px 20px;
    background-color: #f6f7f3;
}

.certification-intro-title {
    max-width: 1350px;
    margin: 0 auto 42px;
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 1px;
    font-family: var(--body-font);
    color: #111;
}

.certification-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    max-width: 1350px;
    margin: 0 auto;
    align-items: center;
}

.certification-text {
    padding: 8px 0;
}

.certification-text h3 {
    font-size: 24px;
    margin-bottom: 30px;
    color: #000;
}

.certification-list {
    list-style: none;
    padding: 0;
    margin: 0;
}



details.cert-item {
    border-bottom: 1px solid #d8ddd3;
    margin-bottom: 0;
    padding: 15px 0;
}

details.cert-item:first-child {
    border-top: 1px solid #d8ddd3;
}

details.cert-item:last-child {
    border-bottom: none;
}

summary.cert-header {
    padding: 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
    color: #000;
    background-color: transparent;
    transition: color 0.3s ease;
    user-select: none;
    list-style: none;
}

summary.cert-header:hover {
    color: var(--brand-heading);
}

summary.cert-header::marker {
    display: none;
}

summary.cert-header::before {
    content: '+';
    font-size: 20px;
    font-weight: bold;
    margin-left: auto;
    transition: transform 0.3s ease;
    padding-left: 15px;
    margin-right: 4px;
}

details.cert-item[open] summary.cert-header::before {
    content: '−';
}

.cert-content {
    padding: 15px 0 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #666;
}

.cert-content p {
    font-size: 14px;
    line-height: 1.6;
    color: #666;
    margin: 0;
}

.certification-image img {
    max-width: 100%;
    height: auto;
    border-radius: 2px;
    display: block;
    box-shadow: 18px 18px 0 #e3e8df;
}

/* ========== CERTIFIED QUALITY ASSURANCE SECTION ========== */
.certified-quality-section {
    padding: 60px 20px;
    background-color: #fff;
    text-align: center;
}

.section-title {
    font-size: 36px;
    font-weight: 300;
    margin-bottom: 15px;
    letter-spacing: 1px;
    color: #000;
    font-family: var(--body-font);
}

.section-subtitle {
    font-size: 14px;
    color: #666;
    margin-bottom: 50px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.certificates-carousel {
    max-width: 1350px;
    margin: 0 auto;
    position: relative;
}

.carousel-controls {
    display: none;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 16px;
}

.carousel-btn {
    width: 42px;
    height: 42px;
    border: 1px solid #d6d6d6;
    background: #fff;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    color: #1a1a1a;
    transition: all 0.2s ease;
}

.carousel-btn:hover {
    background: #f3f3f3;
}

.certificates-grid {
    display: flex;
    overflow-x: auto;
    gap: 24px;
    align-items: stretch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 8px;
}

.certificates-grid::-webkit-scrollbar {
    display: none;
}

.certificate-item {
    text-align: center;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    padding-bottom: 16px;
    flex: 0 0 calc(33.333% - 16px);
    scroll-snap-align: start;
}

.certificate-item img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    margin-bottom: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

.certificate-item h3 {
    font-size: 14px;
    font-weight: 600;
    color: #000;
    margin: 0;
    padding: 0 8px;
}

/* ========== COMMITMENT EXCELLENCE SECTION ========== */
.commitment-section {
    padding: 60px 20px;
    background-color: #fff;
}

.commitment-content {
    max-width: 1350px;
    margin: 0 auto;
}

.commitment-text {
    margin-bottom: 60px;
}

.commitment-text p:first-child {
    font-size: 15px;
    line-height: 1.8;
    color: #000;
    margin-bottom: 30px;
    font-weight: 600;
}

.commitment-text p {
    font-size: 15px;
    line-height: 1.8;
    color: #333;
    margin-bottom: 30px;
}

.certification-badges {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 20px;
    margin: 50px 0;
    align-items: center;
    justify-items: center;
}

.badge {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background-color: transparent;
    padding: 0;
}

.badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.transparency-statement {
    text-align: left;
    max-width: 100%;
    margin: 50px 0 0 0;
    padding: 30px 0;
    background-color: transparent;
    border-radius: 0;
    border-left: none;
}

.transparency-statement p {
    font-size: 15px;
    line-height: 1.8;
    color: #000;
    margin: 0;
    font-weight: 600;
}

/* ========== OUR PROMISE SECTION ========== */
.our-promise-section {
    background-color: #fff;
    padding: 60px 20px;
    margin-top: 30px;
}

.promise-content {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 0;
    max-width: 1350px;
    margin: 0 auto;
    align-items: center;
    background-color: #f8f8f8;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.promise-text {
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.promise-text h2 {
    font-size: 32px;
    font-weight: 300;
    margin-bottom: 14px;
    letter-spacing: 2px;
    color: #111;
    font-family: var(--body-font);
}

.promise-text p {
    font-size: 15px;
    line-height: 1.75;
    color: #444;
    margin: 0;
    max-width: 520px;
}

.promise-image {
    overflow: hidden;
    min-height: 320px;
}

.promise-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* ========== RESPONSIVE DESIGN ========== */
@media (max-width: 900px) {
    .certification-badges {
        grid-template-columns: repeat(5, 1fr);
    }

    .badge {
        width: 90px;
        height: 90px;
    }
}

@media (min-width: 769px) {
    .carousel-controls {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
    }
}

@media (max-width: 768px) {
    .certifications-banner {
        padding: 70px 16px;
    }

    .certification-list-section {
        padding: 40px 16px;
    }

    .certified-quality-section {
        padding: 48px 16px;
    }

    .commitment-section {
        padding: 48px 16px;
    }

    .our-promise-section {
        padding: 48px 16px;
        margin-top: 24px;
    }

    .banner-title {
        font-size: 36px;
        margin-bottom: 12px;
    }

    .banner-subtitle {
        font-size: 15px;
    }

    .section-title {
        font-size: 28px;
        margin-bottom: 10px;
    }

    .section-subtitle {
        margin-bottom: 30px;
        font-size: 13px;
    }

    .carousel-controls {
        display: flex;
    }

    .certificates-grid {
        display: flex;
        overflow-x: auto;
        gap: 16px;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .certificates-grid::-webkit-scrollbar {
        display: none;
    }

    .certificate-item {
        flex: 0 0 calc(50% - 8px);
        max-width: calc(50% - 8px);
        scroll-snap-align: start;
    }

    .certificate-item:nth-child(5) {
        display: flex;
        flex-direction: column;
    }

    .certification-content {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .certification-text h3 {
        margin-bottom: 20px;
    }

    .certification-image img {
        border-radius: 6px;
    }

    .certification-badges {
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin: 24px 0 0;
    }

    .promise-content {
        grid-template-columns: 1fr;
        border-radius: 12px;
    }

    .promise-text {
        padding: 24px 16px;
    }

    .promise-text h2 {
        font-size: 24px;
        margin-bottom: 10px;
    }

    .promise-text p {
        font-size: 14px;
    }

    .promise-image {
        min-height: 220px;
    }

    .badge {
        width: 76px;
        height: 76px;
    }

    .transparency-statement {
        margin: 24px 0 0;
        padding: 16px 0 0;
    }

    .transparency-statement p {
        font-size: 14px;
    }
}
</style>

