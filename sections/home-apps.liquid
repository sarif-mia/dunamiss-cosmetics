{% style %}
  #shopify-section-{{ section.id }} .home-apps__content {
    min-width: 0;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .home-apps__content > .shopify-app-block {
    min-width: 0;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .home-apps__heading {
    margin: 0 0 24px;
    font-size: clamp(20px, 2.5vw, 30px);
    line-height: 1.3;
    color: var(--brand-heading, #1a1a1a);
  }
  /* These rules precede the app HTML to prevent both skeletons painting at once. */
  #shopify-section-{{ section.id }} .ShopVid-Skeleton.__Mobile {
    display: none !important;
  }
  #shopify-section-{{ section.id }} .ShopVid-Skeleton__Grid {
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ShopVid-Skeleton.__Desktop .ShopVid-Skeleton__Item:nth-child(n+6) {
    display: none;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .ShopVid-Skeleton.__Desktop {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .ShopVid-Skeleton.__Mobile {
      display: block !important;
    }
    #shopify-section-{{ section.id }} .ShopVid-Skeleton.__Mobile .ShopVid-Skeleton__Item:nth-child(n+3) {
      display: none;
    }
    #shopify-section-{{ section.id }} .home-apps__heading { margin-bottom: 18px; }
  }
  #shopify-section-{{ section.id }} .ShopVid-Shoppable._mpLoaded .ShopVid-Skeleton {
    display: none !important;
  }
{% endstyle %}
<div class="fluid_container home-apps-spacing">
  {% if section.settings.heading != blank %}
    <h2 class="home-apps__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}
  <div class="home-apps__content">
    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Homepage apps",
  "tag": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch It. Love It. Shop It." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Homepage apps" }]
}
{% endschema %}
