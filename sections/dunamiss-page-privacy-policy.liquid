     DUNAMISS PRIVACY POLICY
     FULL BODY BACKGROUND DESIGN
================================ -->

<style>
  .dm-privacy-page {
    --brown: var(--brand-rose);
    --dark: var(--brand-ink);
    --muted: var(--brand-muted);
    --cream: var(--brand-ivory);
    --white: var(--color-white);

    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 70px 20px;
    font-family: var(--body-font);
    color: var(--dark);
    background: var(--brand-ivory);
  }

  .dm-privacy-page *,
  .dm-privacy-page *::before,
  .dm-privacy-page *::after {
    box-sizing: border-box;
  }

  /* DECORATIVE VECTOR BACKGROUND */

  .dm-bg-circle {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--brand-rose) 15%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .dm-bg-circle.one {
    width: 420px;
    height: 420px;
    left: -230px;
    top: 80px;
  }

  .dm-bg-circle.two {
    width: 600px;
    height: 600px;
    right: -360px;
    top: 400px;
  }

  .dm-bg-circle.three {
    width: 260px;
    height: 260px;
    right: 8%;
    top: 50px;
    border-style: dashed;
  }

  .dm-bg-line {
    position: absolute;
    width: 180px;
    height: 180px;
    right: 5%;
    top: 190px;
    border: 1px solid rgba(143,104,80,.13);
    transform: rotate(45deg);
    pointer-events: none;
  }

  /* MAIN WRAPPER */

  .dm-privacy-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1050px;
    margin: auto;
  }

  /* HERO */

  .dm-privacy-hero {
    position: relative;
    overflow: hidden;
    padding: 65px 55px;
    margin-bottom: 22px;

    border-radius: 30px;

    background: var(--color-white);

    border: 1px solid color-mix(in srgb, var(--brand-rose) 12%, transparent);

    box-shadow:
      0 25px 70px rgba(67,47,35,.12),
      inset 0 1px rgba(255,255,255,.8);

  }

  .dm-privacy-hero::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    right: -130px;
    top: -150px;

    border: 1px solid rgba(143,104,80,.15);
    border-radius: 50%;
  }

  .dm-privacy-hero::after {
    content: "";
    position: absolute;
    width: 170px;
    height: 170px;
    right: -65px;
    top: -85px;

    border: 1px solid rgba(143,104,80,.12);
    border-radius: 50%;
  }

  .dm-privacy-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 15px;

    color: var(--brown);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .dm-privacy-tag svg {
    width: 17px;
    height: 17px;
  }

  .dm-privacy-hero h1 {
    position: relative;
    z-index: 2;

    margin: 0 0 15px;

    font-family: var(--body-font);
    font-size: clamp(38px, 6vw, 60px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .dm-privacy-hero p {
    position: relative;
    z-index: 2;

    max-width: 650px;
    margin: 0;

    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }

  /* PRIVACY BADGES */

  .dm-privacy-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;

    margin-top: 28px;
  }

  .dm-privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 9px 13px;

    border-radius: 30px;

    color: var(--brand-muted);
    font-size: 11px;

    background: var(--brand-blush);
    border: 1px solid color-mix(in srgb, var(--brand-rose) 13%, transparent);
  }

  .dm-privacy-badge svg {
    width: 15px;
    height: 15px;
    color: var(--brown);
  }

  /* CONTENT PANEL */

  .dm-privacy-content {
    position: relative;

    padding: 25px;

    border-radius: 28px;

    background: var(--color-white);

    border: 1px solid color-mix(in srgb, var(--brand-rose) 10%, transparent);

    box-shadow:
      0 25px 70px rgba(67,47,35,.08);

  }

  /* SECTIONS */

  .dm-privacy-section {
    position: relative;

    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 22px;

    padding: 28px 25px;

    border-bottom: 1px solid color-mix(in srgb, var(--brand-rose) 12%, transparent);
  }

  .dm-privacy-section:last-child {
    border-bottom: 0;
  }

  .dm-privacy-number {
    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border-radius: 17px;

    color: var(--brown);

    background:
      linear-gradient(
        145deg,
        var(--brand-blush),
        var(--brand-ivory)
      );

    border: 1px solid color-mix(in srgb, var(--brand-rose) 12%, transparent);

    font-family: var(--body-font);
    font-size: 16px;

    box-shadow:
      0 8px 20px rgba(100,70,50,.07);
  }

  .dm-privacy-section h2 {
    margin: 3px 0 13px;

    font-family: var(--body-font);
    font-size: 23px;
    font-weight: 500;
  }

  .dm-privacy-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dm-privacy-list li {
    position: relative;

    padding-left: 25px;
    margin-bottom: 9px;

    color: var(--brand-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .dm-privacy-list li:last-child {
    margin-bottom: 0;
  }

  .dm-privacy-list li::before {
    content: "";
    position: absolute;

    width: 7px;
    height: 7px;

    left: 2px;
    top: 8px;

    border-radius: 50%;

    background: var(--brand-rose);
  }

  /* FEATURE BOX */

  .dm-feature-box {
    display: flex;
    gap: 15px;

    margin-top: 18px;
    padding: 19px;

    border-radius: 17px;

    background:
      linear-gradient(
        135deg,
        var(--brand-blush),
        var(--brand-ivory)
      );

    border: 1px solid color-mix(in srgb, var(--brand-rose) 13%, transparent);
  }

  .dm-feature-icon {
    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: var(--color-white);

    color: var(--brown);
  }

  .dm-feature-icon svg {
    width: 21px;
    height: 21px;
  }

  .dm-feature-box strong {
    display: block;
    margin-bottom: 4px;

    font-size: 13px;
  }

  .dm-feature-box p {
    margin: 0;

    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  /* SUPPORT */

  .dm-privacy-support {
    position: relative;
    overflow: hidden;

    margin-top: 22px;
    padding: 38px;

    border-radius: 26px;

    color: var(--color-white);
    background: var(--brand-ink);

    box-shadow:
      0 20px 50px rgba(67,47,35,.16);
  }

  .dm-privacy-support::before {
    content: "";
    position: absolute;

    width: 220px;
    height: 220px;

    right: -90px;
    bottom: -110px;

    border: 1px solid rgba(255,255,255,.14);
    border-radius: 50%;
  }

  .dm-privacy-support h2 {
    position: relative;
    z-index: 2;

    margin: 0 0 7px;

    font-family: var(--body-font);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-white);
  }

  .dm-privacy-support p {
    position: relative;
    z-index: 2;

    max-width: 600px;
    margin: 0 0 20px;

    color: color-mix(in srgb, var(--color-white) 75%, transparent);
    font-size: 13px;
    line-height: 1.7;
  }

  .dm-contact-buttons {
    position: relative;
    z-index: 2;

    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .dm-contact-buttons :is(a, .dm-contact-hours) {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 10px 14px;

    border-radius: 30px;

    color: var(--color-white);
    text-decoration: none;

    background: color-mix(in srgb, var(--color-white) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-white) 20%, transparent);

    font-size: 11px;
  }

  .dm-contact-buttons svg {
    width: 14px;
    height: 14px;
  }

  /* FOOTER */

  .dm-privacy-footer {
    padding-top: 22px;

    text-align: center;

    color: var(--brand-muted);

    font-family: var(--body-font);
    font-size: 13px;
    font-style: italic;
  }

  /* MOBILE */

  @media(max-width:700px) {

    .dm-privacy-page {
      padding: 35px 13px;
    }

    .dm-privacy-hero {
      padding: 38px 25px;
      border-radius: 22px;
    }

    .dm-privacy-content {
      padding: 8px;
      border-radius: 22px;
    }

    .dm-privacy-section {
      grid-template-columns: 1fr;
      gap: 13px;
      padding: 23px 16px;
    }

    .dm-privacy-number {
      width: 43px;
      height: 43px;
      border-radius: 13px;
      font-size: 13px;
    }

    .dm-privacy-section h2 {
      font-size: 20px;
    }

    .dm-privacy-support {
      padding: 30px 22px;
      border-radius: 21px;
    }

    .dm-contact-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .dm-contact-buttons :is(a, .dm-contact-hours) {
      justify-content: center;
    }

  }
</style>


