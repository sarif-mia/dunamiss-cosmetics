<div style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
<script src="{{ 'dunamiss-content-editor.js' | asset_url }}" defer></script>
{% assign dm_content_1 = section.blocks | where: 'type', 'content_1' | first %}
{% assign dm_content_2 = section.blocks | where: 'type', 'content_2' | first %}
{% assign dm_content_3 = section.blocks | where: 'type', 'content_3' | first %}
{% assign dm_content_4 = section.blocks | where: 'type', 'content_4' | first %}
{% assign dm_content_5 = section.blocks | where: 'type', 'content_5' | first %}
{% assign dm_content_6 = section.blocks | where: 'type', 'content_6' | first %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .dunamiss-contact-container{
        width:90%;
        max-width:1350px;
        margin:auto;
    }


    /*==============================
        HERO
    ==============================*/

    .dunamiss-contact-hero{
        background:var(--brand-ivory);
        padding:90px 0;
        text-align:center;
    }

    .dunamiss-contact-hero h1{
        font-family: var(--body-font);
        font-size:72px;
        font-weight:400;
        margin-bottom:10px;
        color:var(--brand-ink);
    }

    .dunamiss-contact-hero p{
        max-width:760px;
        margin:auto;
        font-size:19px;
        color:var(--brand-muted);
        line-height:1.9;
    }


    /*==============================
        CONTACT
    ==============================*/

    .dunamiss-contact-contact-section{
        padding:80px 0;
    }

    .dunamiss-contact-contact-grid{
        display:grid;
        grid-template-columns:360px 1fr;
        gap:40px;
        align-items:start;
    }


    /*==============================
        SUPPORT CARD
    ==============================*/

    .dunamiss-contact-support-card{
        background:var(--brand-rose);
        color:var(--color-white);
        padding:40px 35px;
        border-radius:8px;
    }

    .dunamiss-contact-support-card h2{
        font-family: var(--body-font);
        font-size: 33px;
        font-weight:400;
        margin-bottom:15px;
        margin-top: 0;
        color:var(--color-white);
    }

    .dunamiss-contact-support-card p{
        font-size:14px;
        opacity:.95;
        margin-bottom:20px;
        line-height:1.8;
    }

    .dunamiss-contact-support-item{
        display:flex;
        align-items:flex-start;
        gap:18px;
        margin-bottom:20px;
    }

    .dunamiss-contact-support-item i{
        width:22px;
        font-size:18px;
        margin-top:4px;
    }

    .dunamiss-contact-support-item span{
        font-size:14px;
        line-height:1.8;
    }

    .dunamiss-contact-support-item a{
        color:var(--color-white);
        font-weight:600;
        text-decoration:underline;
        text-underline-offset:3px;
    }

    .dunamiss-contact-social-icons{
        margin-top:35px;
        display:flex;
        gap:15px;
    }

    .dunamiss-contact-social-icons a{
        width:50px;
        height:50px;
        border:1px solid rgba(255,255,255,.5);
        border-radius:50%;
        display:flex;
        justify-content:center;
        align-items:center;
        transition:.3s;
        text-decoration:none;
    }

    .dunamiss-contact-social-icons a i{
        font-size:22px;
    }

    .dunamiss-contact-social-icons a:hover{
        background:var(--color-white);
        color:var(--brand-rose);
    }


    /*==============================
        FORM
    ==============================*/

    .dunamiss-contact-contact-form h2{
        font-family: var(--body-font);
        font-size:56px;
        font-weight:400;
        margin-bottom:12px;
        margin-top:10px;
    }

    .dunamiss-contact-contact-form p{
        color:var(--brand-muted);
        margin-bottom:30px;
        line-height:1.8;
        font-size:14px;
    }

    .dunamiss-contact-row{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:25px;
        margin-bottom:25px;
    }

    .dunamiss-contact-contact-form input{
        width:100%;
        height:60px;
        border:1px solid var(--brand-rose);
        padding:0 18px;
        font-size:14px;
        transition:.3s;
        border-radius: 5px;
    }

    .dunamiss-contact-contact-form textarea{
        width:100%;
        height:140px;
        border:1px solid var(--brand-rose);
        padding:18px;
        font-size:14px;
        margin-bottom:22px;
        transition:.3s;
        border-radius: 5px;
    }

    .dunamiss-contact-contact-form input:focus,
    .dunamiss-contact-contact-form textarea:focus{
        border-color:var(--brand-blush);
    }

    .dunamiss-contact-checkbox{
        display:flex;
        align-items:center;
        gap:10px;
        margin-bottom:28px;
        font-size:14px;
        color:var(--brand-muted);
    }

    .dunamiss-contact-checkbox input{
        width:16px;
        height:16px;
    }

    .dunamiss-contact-checkbox a{
        color:var(--brand-rose);
    }

    .dunamiss-contact-contact-form button{
        width:100%;
        height:60px;
        border:none;
        background:var(--brand-rose);
        color:var(--color-white);
        letter-spacing:2px;
        font-size:14px;
        cursor:pointer;
        transition:.3s;
        border-radius: 5px;
    }

    .dunamiss-contact-contact-form button:hover{
        background:var(--brand-ink);
    }
    /*====================================
        LOCATION SECTION
    ====================================*/

    .dunamiss-contact-location{
        padding:80px 0;
    }

    .dunamiss-contact-location-grid{
        display:grid;
        grid-template-columns:480px 1fr;
        gap:40px;
        align-items:center;
        background:var(--brand-blush);
        border-radius:8px;
        overflow:hidden;
    }

    .dunamiss-contact-location-content{
        padding:60px 35px;
    }

    .dunamiss-contact-location-content h2{
        font-family: var(--body-font);
        font-size:45px;
        line-height:1.1;
        font-weight:400;
        margin-bottom:35px;
        color:var(--brand-ink);
    }

    .dunamiss-contact-location-content h4{
        font-size:32px;
        font-family: var(--body-font);
        font-weight:500;
        margin-bottom:18px;
        color:var(--brand-ink);
    }

    .dunamiss-contact-location-content p{
        color:var(--brand-muted);
        font-size:14px;
        line-height:1.8;
    }

    .dunamiss-contact-map{
        width:100%;
        height:100%;
    }

    .dunamiss-contact-map img{
        width:100%;
        height:100%;
        min-height:420px;
        object-fit:cover;
    }


    /*====================================
        FAQ
    ====================================*/

    .dunamiss-contact-faq{
        padding:110px 0;
    }

    .dunamiss-contact-faq h2{
        font-family: var(--body-font);
        font-size:64px;
        text-align:center;
        font-weight:400;
        margin-bottom:70px;
        color:var(--brand-ink);
    }

    .dunamiss-contact-faq-item{
        border-bottom:1px solid var(--color-border);
        margin-bottom: 25px;
    }

    .dunamiss-contact-faq-question{
        width:100%;
        background:var(--brand-blush);
        border:none;
        padding:22px 35px;
        display:flex;
        justify-content:space-between;
        align-items:center;
        text-align: left;
        cursor:pointer;
        font-size:26px;
        font-family: var(--body-font);
        color:var(--brand-ink);
        transition:.3s;
    }

    .dunamiss-contact-faq-question:hover{
        background:var(--brand-ivory);
    }

    .dunamiss-contact-faq-question i{
        font-size:22px;
        color:var(--brand-muted);
        transition:.35s ease;
    }

    .dunamiss-contact-faq-answer{
        max-height:0;
        overflow:hidden;
        transition:max-height .35s ease;
        background:var(--color-white);
    }

    .dunamiss-contact-faq-answer p{
        padding:30px;
        font-size:14px;
        color:var(--brand-muted);
        line-height:1.8;
    }


    /* Accordion Active */

    .dunamiss-contact-faq-item.active .dunamiss-contact-faq-question i{
        transform:rotate(45deg);
        color:var(--brand-rose);
    }

    .dunamiss-contact-faq-item.active .dunamiss-contact-faq-question{
        color:var(--brand-rose);
    }
    /*====================================
        BADGES SECTION
    ====================================*/

    .dunamiss-contact-badges{
        padding:100px 0;
        background:var(--brand-ivory);
    }

    .dunamiss-contact-badges h2{
        max-width:900px;
        margin:0 auto 70px;
        text-align:center;
        font-family: var(--body-font);
        font-size:58px;
        font-weight:400;
        line-height:1.25;
        color:var(--brand-ink);
    }

    .dunamiss-contact-badge-wrapper{
        display:flex;
        justify-content:center;
        align-items:center;
        gap:35px;
        flex-wrap:wrap;
    }

    .dunamiss-contact-badge-wrapper img{
        width:140px;
        height:140px;
        object-fit:contain;
        transition:.3s ease;
    }

    .dunamiss-contact-badge-wrapper img:hover{
        transform:translateY(-8px);
    }


    /*====================================
        RESPONSIVE
    ====================================*/

    /* Large Devices */

    @media (max-width:1200px){

        .dunamiss-contact-hero h1{
            font-size:60px;
        }

        .dunamiss-contact-contact-form h2{
            font-size:48px;
        }

        .dunamiss-contact-faq h2{
            font-size:54px;
        }

        .dunamiss-contact-badges h2{
            font-size:48px;
        }

        .dunamiss-contact-location-content h2{
            font-size:48px;
        }

    }


    /* Tablet */

    @media (max-width:992px){

        .dunamiss-contact-hero{
            padding:70px 0;
        }

        .dunamiss-contact-hero h1{
            font-size:52px;
        }

        .dunamiss-contact-hero p{
            font-size:17px;
        }

        .dunamiss-contact-contact-grid{
            grid-template-columns:1fr;
        }

        .dunamiss-contact-support-card{
            order:2;
        }

        .dunamiss-contact-contact-form{
            order:1;
        }

        .dunamiss-contact-location-grid{
            grid-template-columns:1fr;
        }

        .dunamiss-contact-location-content{
            padding:50px 35px;
        }

        .dunamiss-contact-map img{
            min-height:350px;
        }

        .dunamiss-contact-faq h2{
            font-size:48px;
        }

        .dunamiss-contact-faq-question{
            font-size:22px;
            padding:24px 25px;
        }

        .dunamiss-contact-faq-answer p{
            padding:0 25px 25px;
        }

        .dunamiss-contact-badges h2{
            font-size:42px;
        }

    }


    /* Mobile */

    @media (max-width:768px){

        .dunamiss-contact-container{
            width:92%;
        }

        .dunamiss-contact-hero{
            padding:60px 0;
        }

        .dunamiss-contact-hero h1{
            font-size:42px;
        }

        .dunamiss-contact-hero p{
            font-size:16px;
        }

        .dunamiss-contact-contact-section,
        .dunamiss-contact-location,
        .dunamiss-contact-faq,
        .dunamiss-contact-badges{
            padding:70px 0;
        }

        .dunamiss-contact-contact-form h2{
            font-size:40px;
        }

        .dunamiss-contact-row{
            grid-template-columns:1fr;
            gap:20px;
        }

        .dunamiss-contact-contact-form input{
            height:55px;
        }

        .dunamiss-contact-contact-form textarea{
            height:150px;
        }

        .dunamiss-contact-support-card{
            padding:35px 25px;
        }

        .dunamiss-contact-support-card h2{
            font-size:34px;
        }

        .dunamiss-contact-location-content{
            padding:40px 25px;
        }

        .dunamiss-contact-location-content h2{
            font-size:42px;
        }

        .dunamiss-contact-location-content h4{
            font-size:26px;
        }

        .dunamiss-contact-faq h2{
            font-size:38px;
            margin-bottom:45px;
        }

        .dunamiss-contact-faq-question{
            font-size:18px;
            padding:22px 20px;
        }

        .dunamiss-contact-faq-question i{
            font-size:18px;
        }

        .dunamiss-contact-faq-answer p{
            padding:0 20px 22px;
            font-size:15px;
        }

        .dunamiss-contact-badges h2{
            font-size:34px;
            margin-bottom:45px;
        }

        .dunamiss-contact-badge-wrapper{
            gap:20px;
        }

        .dunamiss-contact-badge-wrapper img{
            width:100px;
            height:100px;
        }

    }


    /* Small Mobile */

    @media (max-width:480px){

        .dunamiss-contact-hero h1{
            font-size:34px;
        }

        .dunamiss-contact-hero p{
            font-size:15px;
        }

        .dunamiss-contact-contact-form h2{
            font-size:34px;
        }

        .dunamiss-contact-support-card h2{
            font-size:30px;
        }

        .dunamiss-contact-location-content h2{
            font-size:34px;
        }

        .dunamiss-contact-location-content h4{
            font-size:22px;
        }

        .dunamiss-contact-faq h2{
            font-size:30px;
        }

        .dunamiss-contact-faq-question{
            font-size:16px;
            padding:18px;
        }

        .dunamiss-contact-faq-answer p{
            font-size:14px;
        }

        .dunamiss-contact-badges h2{
            font-size:28px;
            line-height:1.4;
        }

        .dunamiss-contact-badge-wrapper img{
            width:80px;
            height:80px;
        }

        .dunamiss-contact-social-icons{
            justify-content:flex-start;
            flex-wrap:wrap;
        }

    }
</style>


<!-- =========================
            HERO SECTION
    ========================== -->

<section class="dunamiss-contact-hero">

    <div class="dunamiss-contact-container">

        <h1 {{ dm_content_1.shopify_attributes }}>{{ dm_content_1.settings.field_1 | escape }}</h1>

        <p>
            {{ dm_content_1.settings.field_2 | escape }}
        </p>

    </div>

</section>



<!-- =========================
        CONTACT SECTION
    ========================== -->

<section class="dunamiss-contact-contact-section">

    <div class="dunamiss-contact-container dunamiss-contact-contact-grid">

        <!-- Left -->

        <div class="dunamiss-contact-support-card">

            <h2 {{ dm_content_2.shopify_attributes }}>{{ dm_content_2.settings.field_3 | escape }}</h2>

            <p>
                {{ dm_content_2.settings.field_4 | escape }}
            </p>


            <div class="dunamiss-contact-support-item">

                <i class="fa-solid fa-location-dot"></i>

                <span>
                        {{ dm_content_2.settings.field_5 | escape }}
                    </span>

            </div>



            <div class="dunamiss-contact-support-item">

                <i class="fa-regular fa-clock"></i>

                <span>
                        {{ dm_content_2.settings.field_6 | escape }}
                    </span>

            </div>



            <div class="dunamiss-contact-support-item">

                <i class="fa-solid fa-phone"></i>

                <span>
                        <a href="{% if dm_content_2.settings.field_7 != blank %}{{ dm_content_2.settings.field_7 | escape }}{% else %}https://wa.me/919516656907{% endif %}">{{ dm_content_2.settings.field_8 | escape }}</a>
                    </span>

            </div>
            <div class="dunamiss-contact-support-item">

                <i class="fa-regular fa-envelope"></i>

                <span>
                        {{ dm_content_2.settings.field_9 | escape }}
                        <a href="{% if dm_content_2.settings.field_10 != blank %}{{ dm_content_2.settings.field_10 | escape }}{% else %}mailto:care@dunamiss.in{% endif %}">{{ dm_content_2.settings.field_11 | escape }}</a>
                    </span>

            </div>

            <div class="dunamiss-contact-social-icons">

                <a href="{% if dm_content_2.settings.field_12 != blank %}{{ dm_content_2.settings.field_12 | escape }}{% else %}https://www.facebook.com/profile.php?id=61552254965408{% endif %}" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="{% if dm_content_2.settings.field_13 != blank %}{{ dm_content_2.settings.field_13 | escape }}{% else %}https://www.youtube.com/@dunamisscosmetics/{% endif %}" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-youtube"></i>
                </a>

                <a href="{% if dm_content_2.settings.field_14 != blank %}{{ dm_content_2.settings.field_14 | escape }}{% else %}https://www.instagram.com/dunamisscosmetics{% endif %}" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-instagram"></i>
                </a>

            </div>

        </div>

        <!-- Right -->

        <div class="dunamiss-contact-contact-form">

            <h2>{{ dm_content_2.settings.field_15 | escape }}</h2>
            <p>
                {{ dm_content_2.settings.field_16 | escape }}
            </p>

            {% form 'contact', id: 'dunamiss-contact-form', class: 'dunamiss-contact-contact-form' %}

                {% if form.posted_successfully? %}
                    <p class="success" style="margin-bottom: 20px; color: #137f24;">{{ dm_content_2.settings.field_17 | escape }}</p>
                {% else %}
                    {{ form.errors | default_errors }}
                {% endif %}

                <div class="dunamiss-contact-row" {{ dm_content_3.shopify_attributes }}>

                    <input type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ dm_content_2.settings.field_18 | escape }}" aria-label="{{ dm_content_2.settings.field_19 | escape }}" autocomplete="email" required>

                    <input type="text" name="contact[name]" value="{{ form.name | escape }}" placeholder="{{ dm_content_2.settings.field_20 | escape }}" aria-label="{{ dm_content_3.settings.field_21 | escape }}" autocomplete="name" required>
                </div>
                <textarea name="contact[body]" placeholder="{{ dm_content_3.settings.field_22 | escape }}" aria-label="{{ dm_content_3.settings.field_23 | escape }}" required>{{ form.body | escape }}</textarea>

                <label class="dunamiss-contact-checkbox">

                    <input type="checkbox" name="contact[agree]" required>

                    <span>
                            {{ dm_content_3.settings.field_24 | escape }}
                            <a href="{% if dm_content_3.settings.field_25 != blank %}{{ dm_content_3.settings.field_25 | escape }}{% else %}/pages/privacy-policy{% endif %}">{{ dm_content_3.settings.field_26 | escape }}</a>
                            {{ dm_content_3.settings.field_27 | escape }}
                        </span>

                </label>

                <div id="shopify-captcha" data-captcha-sitekey="{{ 'Shopify.Captcha.siteKey' | t }}" style="margin-bottom: 22px;"></div>

                <button type="submit">
                    {{ dm_content_3.settings.field_28 | escape }}
                </button>
            {% endform %}

            <script src="https://cdn.shopify.com/shopifycloud/storefront-common/js/storefront-common.js" defer></script>
        </div>
    </div>
</section>
<!-- =========================
        LOCATION
    ========================== -->

<section class="dunamiss-contact-location">

    <div class="dunamiss-contact-container dunamiss-contact-location-grid">

        <div class="dunamiss-contact-location-content">

            <h2 {{ dm_content_4.shopify_attributes }}>
                    {{ dm_content_4.settings.field_29 | escape }}
                </h2>

            <h4>{{ dm_content_4.settings.field_30 | escape }}</h4>

