<div style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
{% assign dm_content_1 = section.blocks | where: 'type', 'content_1' | first %}
{% assign dm_content_2 = section.blocks | where: 'type', 'content_2' | first %}
{% assign dm_content_3 = section.blocks | where: 'type', 'content_3' | first %}
{% assign dm_content_4 = section.blocks | where: 'type', 'content_4' | first %}
{% assign dm_content_5 = section.blocks | where: 'type', 'content_5' | first %}
<!-- =========================
     DUNAMISS RETURNS & EXCHANGES
========================= -->

<style>
  .dm-return {
    --dm-bg: #f8f3ef;
    --dm-card: #ffffff;
    --dm-text: var(--brand-text);
    --dm-muted: var(--brand-text);
    --dm-accent: var(--brand-accent);
    --dm-accent-dark: var(--brand-accent);
    --dm-accent-light: #f8e7ed;
    --dm-border: #eadbd4;
    --dm-green: #587254;
    --dm-warning: #a16b3f;

    max-width: 1000px;
    margin: 50px auto;
    padding: 0 20px;
    font-family: var(--body-font);
    color: var(--dm-text);
  }

  .dm-return *,
  .dm-return *::before,
  .dm-return *::after {
    box-sizing: border-box;
  }

  /* =========================
     HERO
  ========================= */

  .dm-return-hero {
    position: relative;
    overflow: hidden;
    padding: 58px 48px;
    margin-bottom: 24px;
    border-radius: 24px;

    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(255,255,255,.55) 0,
        rgba(255,255,255,0) 32%
      ),
      linear-gradient(
        135deg,
        var(--brand-surface) 0%,
        #f5e7e1 48%,
        #eee0d8 100%
      );

    border: 1px solid var(--brand-border);
    box-shadow: 0 12px 35px rgba(100, 55, 65, .08);
  }

  .dm-return-hero::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -70px;
    bottom: -110px;
    border-radius: 50%;
    background: rgba(184, 92, 120, .10);
  }

  .dm-return-eyebrow {
    position: relative;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 13px;

    color: var(--dm-accent-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .dm-return-eyebrow svg {
    width: 16px;
    height: 16px;
  }

  .dm-return-hero h1 {
    position: relative;
    z-index: 2;

    margin: 0 0 14px;

    color: var(--brand-heading);

    font-family: var(--body-font);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -1px;
  }

  .dm-return-hero p {
    position: relative;
    z-index: 2;

    max-width: 650px;
    margin: 0;

    color: var(--brand-text);
    font-size: 16px;
    line-height: 1.8;
  }

  /* =========================
     QUICK INFO
  ========================= */

  .dm-return-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .dm-return-highlight {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 19px;

    background: var(--dm-card);
    border: 1px solid var(--dm-border);
    border-radius: 16px;

    box-shadow: 0 6px 22px rgba(70, 45, 35, .055);
  }

  .dm-return-icon {
    flex: 0 0 44px;

    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: var(--dm-accent-dark);
    background: var(--dm-accent-light);
  }

  .dm-return-icon svg {
    width: 21px;
    height: 21px;
  }

  .dm-return-highlight strong {
    display: block;
    margin-bottom: 3px;

    color: var(--brand-heading);
    font-size: 14px;
  }

  .dm-return-highlight span {
    color: var(--dm-muted);
    font-size: 12px;
  }

  /* =========================
     SECTION
  ========================= */

  .dm-return-section {
    margin-bottom: 18px;
    padding: 29px;

    background: var(--dm-card);
    border: 1px solid var(--dm-border);
    border-radius: 20px;

    box-shadow: 0 6px 25px rgba(60, 40, 30, .045);
  }

  .dm-return-section-head {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
  }

  .dm-return-number {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--dm-accent-light);
    color: var(--dm-accent-dark);

    font-size: 13px;
    font-weight: 700;
  }

  .dm-return-section h2 {
    margin: 0 0 5px;

    color: var(--brand-heading);

    font-family: var(--body-font);
    font-size: 23px;
    font-weight: 500;
  }

  .dm-return-intro {
    margin: 0;
    color: var(--dm-muted);
    font-size: 13px;
  }

  /* =========================
     POLICY GRID
  ========================= */

  .dm-return-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }

  .dm-return-card {
    padding: 22px;

    border: 1px solid var(--dm-border);
    border-radius: 16px;

    background: #fcfaf9;
  }

  .dm-return-card.accent {
    background:
      linear-gradient(
        145deg,
        #fff2f5 0%,
        #fffaf8 100%
      );

    border-color: var(--brand-border);
  }

  .dm-return-card h3 {
    display: flex;
    align-items: center;
    gap: 9px;

    margin: 0 0 10px;

    color: var(--brand-heading);
    font-size: 16px;
  }

  .dm-return-card h3 svg {
    width: 18px;
    height: 18px;
    color: var(--dm-accent-dark);
  }

  .dm-return-card p {
    margin: 0;

    color: var(--brand-text);
    font-size: 13px;
    line-height: 1.7;
  }

  /* =========================
     LIST
  ========================= */

  .dm-return-list {
    display: grid;
    gap: 11px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .dm-return-list li {
    position: relative;

    padding-left: 29px;

    color: var(--brand-text);
    font-size: 14px;
    line-height: 1.65;
  }

  .dm-return-list li::before {
    content: "✓";

    position: absolute;
    left: 0;
    top: 1px;

    width: 19px;
    height: 19px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #e9f0e6;
    color: var(--dm-green);

    font-size: 11px;
    font-weight: 700;
  }

  /* =========================
     NOTICE
  ========================= */

  .dm-return-notice {
    display: flex;
    gap: 14px;

    padding: 18px;

    border: 1px solid #eadfd6;
    border-radius: 14px;

    background: #fcf8f4;
  }

  .dm-return-notice.warning {
    background: #fff8ef;
  }

  .dm-return-notice-icon {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border: 1px solid #eadbd2;
    border-radius: 10px;

    background: #fff;
    color: var(--dm-accent-dark);
  }

  .dm-return-notice-icon svg {
    width: 20px;
    height: 20px;
  }

  .dm-return-notice strong {
    display: block;
    margin-bottom: 5px;

    color: var(--brand-heading);
    font-size: 14px;
  }

  .dm-return-notice p {
    margin: 0;

    color: var(--dm-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  /* =========================
     EXCHANGE FLOW
  ========================= */

  .dm-exchange-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;

    position: relative;

    margin-top: 26px;
  }

  .dm-exchange-flow::before {
    content: "";

    position: absolute;
    top: 20px;
    left: 12%;
    right: 12%;

    height: 1px;

    background: #e4d9d2;
  }

  .dm-flow-step {
    position: relative;
    z-index: 1;

    text-align: center;
  }

  .dm-flow-icon {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    margin: 0 auto 13px;

    border: 1px solid #dfc9cd;
    border-radius: 50%;

    background: #fff;
    color: var(--dm-accent-dark);

    box-shadow: 0 3px 10px rgba(90, 50, 60, .05);
  }

  .dm-flow-icon svg {
    width: 19px;
    height: 19px;
  }

  .dm-flow-step strong {
    display: block;
    margin-bottom: 5px;

    color: var(--brand-heading);
    font-size: 13px;
  }

  .dm-flow-step span {
    color: var(--dm-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  /* =========================
     TIME BADGE
  ========================= */

  .dm-time-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    margin-top: 18px;
    padding: 9px 13px;

    border: 1px solid var(--brand-border);
    border-radius: 30px;

    background: #f9eaf0;
    color: var(--dm-accent-dark);

    font-size: 12px;
    font-weight: 700;
  }

  .dm-time-badge svg {
    width: 15px;
    height: 15px;
  }

  /* =========================
     INTERNATIONAL
  ========================= */

  .dm-international {
    display: flex;
    gap: 16px;

    padding: 22px;

    border: 1px solid #e4d8ce;
    border-radius: 16px;

    background:
      linear-gradient(
        135deg,
        #f8f0ea 0%,
        #fffaf7 100%
      );
  }

  .dm-international-icon {
    flex: 0 0 45px;

    width: 45px;
    height: 45px;

    display: grid;
    place-items: center;

    border: 1px solid #e8ddd6;
    border-radius: 12px;

    background: #fff;
    color: var(--dm-accent-dark);
  }

  .dm-international-icon svg {
    width: 22px;
    height: 22px;
  }

  .dm-international h3 {
    margin: 0 0 7px;

    color: var(--brand-heading);
    font-size: 15px;
  }

  .dm-international p {
    margin: 0;

    color: var(--dm-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* =========================
     SUPPORT
  ========================= */

  .dm-return-support {
    position: relative;
    overflow: hidden;

    margin-top: 24px;
    padding: 40px 36px;

    border-radius: 22px;

    color: #fff;

    background:
      radial-gradient(
        circle at 90% 15%,
        rgba(255,255,255,.16),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        var(--brand-accent) 0%,
        var(--brand-accent) 50%,
        var(--brand-accent) 100%
      );

    box-shadow: 0 12px 35px rgba(140, 60, 85, .18);
  }

  .dm-return-support::after {
    content: "";

    position: absolute;

    width: 200px;
    height: 200px;

    right: -70px;
    bottom: -100px;

    border-radius: 50%;

    background: rgba(255,255,255,.08);
  }

  .dm-return-support h2 {
    position: relative;
    z-index: 1;

    margin: 0 0 8px;

    color: #fff;

    font-family: var(--body-font);
    font-size: 28px;
    font-weight: 500;
  }

  .dm-return-support > p {
    position: relative;
    z-index: 1;

    max-width: 650px;

    margin: 0 0 22px;

    color: rgba(255,255,255,.90);

    font-size: 13px;
    line-height: 1.7;
  }

  .dm-return-contact {
    position: relative;
    z-index: 2;

    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dm-return-contact a,
  .dm-return-contact span {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 10px 14px;

    border: 1px solid rgba(255,255,255,.30);
    border-radius: 30px;

    color: #fff;
    text-decoration: none;

    background: rgba(255,255,255,.12);

    font-size: 12px;

    transition: all .2s ease;
  }

  .dm-return-contact a:hover {
    background: rgba(255,255,255,.22);
    border-color: rgba(255,255,255,.50);
    transform: translateY(-1px);
  }

  .dm-return-contact svg {
    width: 15px;
    height: 15px;
  }

  /* =========================
     FOOTER
  ========================= */

  .dm-return-footer {
    padding: 22px 10px 5px;

    text-align: center;

    color: var(--brand-text);

    font-family: var(--body-font);
    font-size: 14px;
    font-style: italic;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .dm-return {
      margin: 25px auto;
      padding: 0 14px;
    }

    .dm-return-hero {
      padding: 36px 25px;
      border-radius: 20px;
    }

    .dm-return-hero h1 {
      font-size: 36px;
    }

    .dm-return-hero p {
      font-size: 14px;
      line-height: 1.7;
    }

    .dm-return-highlights {
      grid-template-columns: 1fr;
    }

    .dm-return-section {
      padding: 22px 18px;
      border-radius: 17px;
    }

    .dm-return-grid {
      grid-template-columns: 1fr;
    }

    .dm-exchange-flow {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .dm-exchange-flow::before {
      display: none;
    }

    .dm-flow-step {
      display: grid;

      grid-template-columns: 45px 1fr;

      text-align: left;
      align-items: center;

      column-gap: 12px;
    }

    .dm-flow-icon {
      grid-row: span 2;
      margin: 0;
    }

    .dm-return-support {
      padding: 30px 22px;
      border-radius: 20px;
    }

    .dm-return-contact {
      flex-direction: column;
      align-items: stretch;
    }

    .dm-return-contact a,
    .dm-return-contact span {
      justify-content: center;
    }

    .dm-international {
      padding: 18px;
    }
  }
</style>


<div class="dm-return">

  <!-- HERO -->
  <section class="dm-return-hero">

    <div class="dm-return-eyebrow" {{ dm_content_1.shopify_attributes }}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 7h16"/>
        <path d="M6 7l1 14h10l1-14"/>
        <path d="M9 7V4h6v3"/>
        <path d="M9 11v6M15 11v6"/>
      </svg>
      {{ dm_content_1.settings.field_1 | escape }}
    </div>

    <h1>{{ dm_content_1.settings.field_2 | escape }}</h1>

    <p>
      {{ dm_content_1.settings.field_3 | escape }}
    </p>

  </section>


  <!-- QUICK HIGHLIGHTS -->
  <div class="dm-return-highlights">

    <div class="dm-return-highlight">

      <div class="dm-return-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M20 12a8 8 0 1 1-2.3-5.7"/>
          <path d="M20 4v8h-8"/>
        </svg>
      </div>

      <div {{ dm_content_2.shopify_attributes }}>
        <strong>{{ dm_content_2.settings.field_4 | escape }}</strong>
        <span>{{ dm_content_2.settings.field_5 | escape }}</span>
      </div>

    </div>


    <div class="dm-return-highlight">

      <div class="dm-return-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 8v4l3 2"/>
        </svg>
      </div>

      <div>
        <strong>{{ dm_content_2.settings.field_6 | escape }}</strong>
        <span>{{ dm_content_2.settings.field_7 | escape }}</span>
      </div>

    </div>


    <div class="dm-return-highlight">

      <div class="dm-return-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/>
          <path d="M8.5 12l2.2 2.2 4.8-5"/>
        </svg>
      </div>

      <div>
        <strong>{{ dm_content_2.settings.field_8 | escape }}</strong>
        <span>{{ dm_content_2.settings.field_9 | escape }}</span>
      </div>

    </div>

  </div>


  <!-- NATIVE SHOPIFY POLICY -->
  <section class="dm-return-section">
    <div class="dm-return-section-head">
      <div>
        <h2 {{ dm_content_3.shopify_attributes }}>{{ dm_content_3.settings.field_10 | escape }}</h2>
      </div>
    </div>
    {% if shop.refund_policy.body != blank %}
      <div class="rte dm-return-policy-content">
        {{ shop.refund_policy.body }}
      </div>
      <p>
        <a href="{{ shop.refund_policy.url | escape }}">{{ dm_content_3.settings.field_11 | escape }}</a>
      </p>
    {% else %}
      <p>{{ dm_content_3.settings.field_12 | escape }}</p>
    {% endif %}
  </section>


  <!-- SUPPORT -->
  <section class="dm-return-support">

    <h2 {{ dm_content_4.shopify_attributes }}>{{ dm_content_4.settings.field_13 | escape }}</h2>

    <p>
      {{ dm_content_4.settings.field_14 | escape }}
    </p>


    <div class="dm-return-contact">

      <a href="{% if dm_content_4.settings.field_15 != blank %}{{ dm_content_4.settings.field_15 | escape }}{% else %}mailto:care@dunamiss.in{% endif %}">

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>

        {{ dm_content_4.settings.field_16 | escape }}

      </a>


      <a href="{% if dm_content_4.settings.field_17 != blank %}{{ dm_content_4.settings.field_17 | escape }}{% else %}https://wa.me/919516656907{% endif %}" aria-label="{{ dm_content_4.settings.field_18 | escape }}">

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M6 3l4 2-2 4c1.3 2.7 3.3 4.7 6 6l4-2 2 4-2 3c-7 1-14-6-13-13L6 3z"/>
        </svg>

        {{ dm_content_4.settings.field_19 | escape }}

      </a>


      <span>

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 2"/>
        </svg>

        {{ dm_content_4.settings.field_20 | escape }}

      </span>

    </div>

  </section>


  <div class="dm-return-footer" {{ dm_content_5.shopify_attributes }}>
    {{ dm_content_5.settings.field_21 | escape }}
  </div>

</div>

</div>
{% schema %}
{
  "name": "Dunamiss returns",
  "tag": "section",
  "class": "dm-editable-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the content groups below. Their positions follow this page’s fixed layout. Additional sections can be added below the page."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "content_1",
      "name": "Dunamiss Care",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "field_1",
          "label": "Dunamiss Care",
          "default": "Dunamiss Care"
        },
        {
          "type": "text",
          "id": "field_2",
          "label": "Returns & Exchanges",
          "default": "Returns & Exchanges"
        },
        {
          "type": "textarea",
          "id": "field_3",
          "label": "Shopping should feel effortless. We've made returns and exchanges",
          "default": "Shopping should feel effortless. We've made returns and exchanges\n      just as smooth. Because your experience matters as much as\n      your skincare."
        }
      ]
    },
    {
      "type": "content_2",
      "name": "Easy Resolution",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "field_4",
          "label": "Easy Resolution",
          "default": "Easy Resolution"
        },
        {
          "type": "text",
          "id": "field_5",
          "label": "We're here to help",
          "default": "We're here to help"
        },
        {
          "type": "text",
          "id": "field_6",
          "label": "Quick Reporting",
          "default": "Quick Reporting"
        },
        {
          "type": "text",
          "id": "field_7",
          "label": "Report issues promptly",
          "default": "Report issues promptly"
        },
        {
          "type": "text",
          "id": "field_8",
          "label": "Quality Verified",
          "default": "Quality Verified"
        },
        {
          "type": "text",
          "id": "field_9",
          "label": "Every request is reviewed",
          "default": "Every request is reviewed"
        }
      ]
    },
    {
      "type": "content_3",
      "name": "Return & Exchange Policy",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "field_10",
          "label": "Return & Exchange Policy",
          "default": "Return & Exchange Policy"
        },
        {
          "type": "text",
          "id": "field_11",
          "label": "View our return and refund policy",
          "default": "View our return and refund policy"
        },
        {
          "type": "text",
          "id": "field_12",
          "label": "Contact our support team for return and exchange eligibility.",
          "default": "Contact our support team for return and exchange eligibility."
        }
      ]
    },
    {
      "type": "content_4",
      "name": "Need Help?",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "field_13",
          "label": "Need Help?",
          "default": "Need Help?"
        },
        {
