<div style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
<div class="cb-booster-shell">{{ page.content }}</div>
<style>.cb-booster-shell{width:100%;max-width:1320px;margin:0 auto;padding:0 16px;box-sizing:border-box}</style>

</div>
{% schema %}
{
  "name": "Crowd buy page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit this page’s content under Online Store → Pages. Add sections below to extend the page."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "limit": 1
}
{% endschema %}
