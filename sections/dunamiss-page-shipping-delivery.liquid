<!-- =========================
     DUNAMISS SHIPPING & DELIVERY
========================= -->

<style>
  .dm-shipping {
    --dm-bg: var(--brand-ivory);
    --dm-card: var(--color-white);
    --dm-text: var(--brand-ink);
    --dm-muted: var(--brand-muted);
    --dm-accent: var(--brand-rose);
    --dm-accent-dark: var(--brand-ink);
    --dm-accent-light: var(--brand-blush);
    --dm-border: var(--color-border);
    --dm-green: #587254;

    max-width: 1000px;
    margin: 50px auto;
    padding: 0 20px;
    font-family: var(--body-font);
    color: var(--dm-text);
  }

  .dm-shipping *,
  .dm-shipping *::before,
  .dm-shipping *::after {
    box-sizing: border-box;
  }

  /* =========================
     HERO
  ========================= */

  .dm-hero {
    position: relative;
    overflow: hidden;

    padding: 58px 48px;
    margin-bottom: 24px;

    border-radius: 24px;

    background:
      radial-gradient(
        circle at 85% 15%,
        rgba(184, 92, 120, .16),
        transparent 32%
      ),
      radial-gradient(
        circle at 10% 90%,
        rgba(184, 92, 120, .08),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        var(--brand-blush) 0%,
        var(--brand-ivory) 48%,
        var(--brand-blush) 100%
      );

    border: 1px solid var(--dm-border);
    box-shadow: 0 12px 35px rgba(100, 55, 65, .08);
  }

  .dm-hero::before {
    content: "";

    position: absolute;

    width: 190px;
    height: 190px;

    right: -70px;
    bottom: -85px;

    border: 1px solid rgba(184, 92, 120, .18);
    border-radius: 50%;
  }

  .dm-hero::after {
    content: "";

    position: absolute;

    width: 115px;
    height: 115px;

    right: 22px;
    bottom: -58px;

    border: 1px solid rgba(184, 92, 120, .13);
    border-radius: 50%;
  }

  .dm-eyebrow {
    position: relative;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 13px;

    color: var(--dm-accent-dark);

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .dm-eyebrow svg {
    width: 16px;
    height: 16px;
  }

  .dm-hero h1 {
    position: relative;
    z-index: 2;

    margin: 0 0 14px;

    color: var(--brand-ink);

    font-family: var(--body-font);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.01em;
  }

  .dm-hero p {
    position: relative;
    z-index: 2;

    max-width: 650px;

    margin: 0;

    color: var(--dm-muted);

    font-size: 16px;
    line-height: 1.8;
  }


  /* =========================
     QUICK BENEFITS
  ========================= */

  .dm-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;

    margin-bottom: 24px;
  }

  .dm-benefit {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 19px;

    background: var(--dm-card);

    border: 1px solid var(--dm-border);
    border-radius: 16px;

    box-shadow: 0 6px 22px rgba(70, 45, 35, .055);
  }

  .dm-icon {
    flex: 0 0 44px;

    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: var(--dm-accent-dark);
    background: var(--dm-accent-light);
  }

  .dm-icon svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
  }

  .dm-benefit strong {
    display: block;

    margin-bottom: 3px;

    color: var(--dm-text);

    font-size: 14px;
  }

  .dm-benefit span {
    color: var(--dm-muted);
    font-size: 12px;
  }


  /* =========================
     CONTENT CARD
  ========================= */

  .dm-section {
    margin-bottom: 18px;
    padding: 29px;

    background: var(--dm-card);

    border: 1px solid var(--dm-border);
    border-radius: 20px;

    box-shadow: 0 6px 25px rgba(60, 40, 30, .045);
  }

  .dm-section-head {
    display: flex;
    align-items: flex-start;
    gap: 15px;

    margin-bottom: 20px;
  }

  .dm-section-number {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--dm-accent-light);
    color: var(--dm-accent-dark);

    font-size: 13px;
    font-weight: 700;
  }

  .dm-section h2 {
    margin: 0 0 5px;

    color: var(--dm-text);

    font-family: var(--body-font);
    font-size: 23px;
    font-weight: 500;
  }

  .dm-section-intro {
    margin: 0;

    color: var(--dm-muted);

    font-size: 13px;
  }


  /* =========================
     POLICY LIST
  ========================= */

  .dm-list {
    display: grid;
    gap: 11px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .dm-list li {
    position: relative;

    padding-left: 29px;

    color: var(--brand-text);

    font-size: 14px;
    line-height: 1.65;
  }

  .dm-list li::before {
    content: "✓";

    position: absolute;

    left: 0;
    top: 2px;

    width: 19px;
    height: 19px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #e9f0e6;
    color: var(--dm-green);

    font-size: 11px;
    font-weight: 700;
  }


  /* =========================
     SHIPPING CARDS
  ========================= */

  .dm-shipping-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }

  .dm-shipping-option {
    position: relative;

    padding: 22px;

    border-radius: 16px;
    border: 1px solid var(--dm-border);

    background: #fcfaf9;
  }

  .dm-shipping-option.featured {
    border-color: var(--brand-border);

    background:
      linear-gradient(
        145deg,
        #fff2f5 0%,
        #fffaf8 100%
      );
  }

  .dm-tag {
    position: absolute;

    top: 15px;
    right: 15px;

    padding: 5px 9px;

    border-radius: 30px;

    background: #e9f0e6;
    color: var(--dm-green);

    font-size: 10px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: .5px;
  }

  .dm-shipping-option h3 {
    margin: 0 0 9px;

    color: var(--dm-text);

    font-size: 16px;
  }

  .dm-price {
    margin-bottom: 10px;

    color: var(--dm-accent-dark);

    font-size: 21px;
    font-weight: 700;
  }

  .dm-price small {
    color: var(--dm-muted);

    font-size: 12px;
    font-weight: 400;
  }

  .dm-shipping-option p {
    margin: 0;

    color: var(--dm-muted);

    font-size: 13px;
    line-height: 1.7;
  }


  /* =========================
     DELIVERY TIMELINE
  ========================= */

  .dm-timeline {
    position: relative;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;

    margin-top: 28px;
  }

  .dm-timeline::before {
    content: "";

    position: absolute;

    top: 20px;
    left: 12%;
    right: 12%;

    height: 1px;

    background: #e4d9d2;
  }

  .dm-step {
    position: relative;

    text-align: center;
  }

  .dm-step-icon {
    position: relative;
    z-index: 2;

    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    margin: 0 auto 13px;

    border-radius: 50%;

    border: 1px solid #dfc9cd;

    background: #fff;

    color: var(--dm-accent-dark);

    box-shadow: 0 3px 10px rgba(90, 50, 60, .05);
  }

  .dm-step-icon svg {
    width: 19px;
    height: 19px;
  }

  .dm-step strong {
    display: block;

    margin-bottom: 5px;

    color: var(--dm-text);

    font-size: 13px;
  }

  .dm-step span {
    color: var(--dm-muted);

    font-size: 12px;
    line-height: 1.5;
  }

  .dm-note {
    margin-top: 20px;

    padding: 15px 17px;

    border: 1px solid #eadfd6;
    border-radius: 12px;

    background: #fcf7f3;

    color: var(--dm-muted);

    font-size: 12px;
    line-height: 1.6;
  }

  .dm-note strong {
    color: var(--dm-text);
  }


  /* =========================
     DELIVERY NOTICE
  ========================= */

  .dm-notice {
    display: flex;
    gap: 14px;

    padding: 18px;

    border: 1px solid #eadfd6;
    border-radius: 14px;

    background: #fcf8f4;
  }

  .dm-notice-icon {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border: 1px solid #eadbd2;
    border-radius: 10px;

    background: #fff;

    color: var(--dm-accent-dark);
  }

  .dm-notice-icon svg {
    width: 20px;
    height: 20px;
  }

  .dm-notice strong {
    display: block;

    margin-bottom: 5px;

    color: var(--dm-text);

    font-size: 14px;
  }

  .dm-notice p {
    margin: 0;

    color: var(--dm-muted);

    font-size: 13px;
    line-height: 1.65;
  }


  /* =========================
     INVOICE
  ========================= */

  .dm-invoice {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 18px;

    border: 1px dashed #d8ccc2;
    border-radius: 14px;

    background: #fcfaf9;
  }

  .dm-invoice svg {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    padding: 9px;

    border-radius: 10px;

    background: var(--dm-accent-light);
    color: var(--dm-accent-dark);
  }

  .dm-invoice strong {
    display: block;

    margin-bottom: 3px;

    color: var(--brand-heading);

    font-size: 14px;
  }

  .dm-invoice span {
    color: var(--dm-muted);
    font-size: 12px;
    line-height: 1.5;
  }


  /* =========================
     SUPPORT
  ========================= */

  .dm-support {
    position: relative;
    overflow: hidden;

    margin-top: 24px;
    padding: 40px 36px;

    border-radius: 22px;

    color: #fff;

    background:
      radial-gradient(
        circle at 90% 15%,
        rgba(255,255,255,.16),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        var(--brand-accent) 0%,
        var(--brand-rose) 50%,
        var(--brand-ink) 100%
      );

    box-shadow: 0 12px 35px rgba(140, 60, 85, .18);
  }


  .dm-support h2 {
    position: relative;
    z-index: 1;

    margin: 0 0 8px;

    color: #fff;

    font-family: var(--body-font);
    font-size: 28px;
    font-weight: 500;
  }

  .dm-support > p {
    position: relative;
    z-index: 1;

    max-width: 650px;

    margin: 0 0 22px;

    color: rgba(255,255,255,.90);

    font-size: 13px;
    line-height: 1.7;
  }

  .dm-contact {
    position: relative;
    z-index: 2;

    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dm-contact a,
  .dm-contact span {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 10px 14px;

    border: 1px solid rgba(255,255,255,.30);
    border-radius: 30px;

    color: #fff;
    text-decoration: none;

    background: rgba(255,255,255,.12);

    font-size: 12px;

    transition: all .2s ease;
  }

  .dm-contact a:hover {
    background: rgba(255,255,255,.22);
    border-color: rgba(255,255,255,.50);
    transform: translateY(-1px);
  }

  .dm-contact svg {
    width: 15px;
    height: 15px;
  }


  /* =========================
     FOOTER
  ========================= */

  .dm-footer {
    padding: 22px 10px 5px;

    text-align: center;

    color: var(--dm-muted);

    font-family: var(--body-font);
    font-size: 14px;
    font-style: italic;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .dm-shipping {
      margin: 25px auto;
      padding: 0 14px;
    }

    .dm-hero {
      padding: 36px 25px;
      border-radius: 20px;
    }

    .dm-hero h1 {
      font-size: 36px;
    }

    .dm-hero p {
      font-size: 14px;
      line-height: 1.7;
    }

    .dm-benefits {
      grid-template-columns: 1fr;
    }

    .dm-section {
      padding: 22px 18px;
      border-radius: 17px;
    }

    .dm-shipping-options {
      grid-template-columns: 1fr;
    }

    .dm-timeline {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .dm-timeline::before {
      display: none;
    }

    .dm-step {
      display: grid;

      grid-template-columns: 45px 1fr;

      text-align: left;

      align-items: center;

      column-gap: 12px;
    }

    .dm-step-icon {
      grid-row: span 2;
      margin: 0;
    }

    .dm-support {
      padding: 30px 22px;
      border-radius: 20px;
    }

    .dm-contact {
      flex-direction: column;
      align-items: stretch;
    }

    .dm-contact a,
    .dm-contact span {
      justify-content: center;
    }

    .dm-invoice {
      align-items: flex-start;
    }
  }
</style>


