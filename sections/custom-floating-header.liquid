{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign section_width = section_st.section_width
  assign transparent = section_st.transparent_header
  assign color_scheme = section_st.color_scheme
  assign top_search = section_st.show_search
  assign my_account = section_st.show_account_icon
  assign recently_viewed = section_st.show_recently_viewed
  assign wishlist = section_st.show_wishlist_icon
  assign minicart = section_st.show_shopping_cart
  assign show_country = section_st.show_currency
  assign show_language = section_st.show_language
  assign transparent_class = ''
  if request.page_type == 'index' and transparent
    assign transparent_class = ' transparent absolute-1025 inset-x-0 z-15'
  endif
-%}
{%- style -%}
  .section-header.section-header-custom-floating {
    --floating-header-gap: 12px;
    position: fixed;
    top: var(--announcement-bar-height, 0px);
    left: 0;
    right: 0;
    z-index: 30;
    padding-block: var(--floating-header-gap);
    background: var(--brand-background, #fffcf8);
    isolation: isolate;
  }
  /* Keep the fixed bar above page content when the theme opens a drawer. */
  body:has(.section-header-custom-floating) .shopify-section-group-header-group.section-announcement-bar:not(.section-header) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }
  body:has(.section-header-custom-floating) #MainContent {
    padding-top: calc(var(--announcement-bar-height, 0px) + var(--floating-header-height, 0px));
  }
  /* Search dialogs and their backdrop must cover the fixed header as well. */
  body:has(.section-header-custom-floating) :is(.search_type_drawer, .search_type_popup) #search-form {
    z-index: 51;
    top: 0;
    bottom: 0;
    height: 100dvh;
    max-height: 100dvh;
  }
  body:has(.section-header-custom-floating) :is(.search_type_drawer, .search_type_popup) ~ .overlay_search {
    z-index: 50;
    right: 0;
  }
  .section-header-custom-floating .header__inner {
    padding: 0;
  }
  .section-header-custom-floating .header__shell {
    margin: 0 auto;
    width: 100%;
    background: {{ section.settings.header_background | default: '#f8f5f0' }};
    border: 1px solid var(--brand-border, #eadbe0);
    box-shadow: 0 4px 16px rgba(26, 26, 26, 0.06);
    border-radius: 18px;
    padding: 4px 6px;
    position: relative;
    z-index: 30;
    overflow: visible;
  }
  .section-header-custom-floating header-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: auto;
  }
  .section-header-custom-floating .header__top-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    gap: 10px;
    z-index: 3;
    flex-wrap: nowrap;
  }
  .section-header-custom-floating .header__menu-toggle {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
    order: 1;
    margin-right: 8px;
  }
  .section-header-custom-floating .header__logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex: 0 0 auto;
    min-width: 0;
    order: 2;
    margin-right: auto;
  }
.section-header-custom-floating .header__action {
    position: static;
    margin-left: auto;
    transform: none;
    z-index: 2;
    flex-shrink: 0;
    order: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-header-custom-floating .header__menu {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    position: relative;
    z-index: 5;
    margin-top: 0;
    margin-left: 10px;
    flex: 1 1 auto;
    min-width: 0;
    order: 3;
    gap: 0;
  }
.section-header-custom-floating .header__menu .level0 {
    position: relative;
    z-index: 1;
  }
  .section-header-custom-floating .header__menu .level0:hover,
  .section-header-custom-floating .header__menu .level0.open {
    z-index: 10;
  }
  .section-header-custom-floating .header__menu .level0 > menu-item {
    padding-left: 5px;
    padding-right: 5px;
  }
.section-header-custom-floating .header__menu .submenu-horizontal {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s ease;
    border-radius: 16px;
    background: var(--color-background, #fff);
    overflow: hidden;
    margin-top: 6px;
    z-index: 999;
  }
  .section-header-custom-floating .header__menu .level0:hover > .submenu-horizontal,
  .section-header-custom-floating .header__menu .level0:focus-within > .submenu-horizontal,
  .section-header-custom-floating .header__menu .level0.open > .submenu-horizontal {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .section-header-custom-floating .header__menu .level0 > menu-item > a {
    padding: 4px 6px;
    border-radius: 0;
    transition: color 0.2s ease;
    position: relative;
    font-size: 1.4rem;
    line-height: 1.2;
    margin: 0;
  }
  .section-header-custom-floating .header__menu .level0 > menu-item > a::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 1px;
    height: 2px;
    width: 80%;
    border-radius: 999px;
    background: var(--brand-surface);
    opacity: 0;
    transform: scaleX(0.7);
    transform-origin: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .section-header-custom-floating .header__menu .level0:hover > menu-item > a,
  .section-header-custom-floating .header__menu .level0:focus-within > menu-item > a,
  .section-header-custom-floating .header__menu .level0.open > menu-item > a {
    color: var(--brand-heading);
  }
  .section-header-custom-floating .header__menu .level0:hover > menu-item > a::after,
  .section-header-custom-floating .header__menu .level0:focus-within > menu-item > a::after,
  .section-header-custom-floating .header__menu .level0.open > menu-item > a::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .section-header-custom-floating .header__action svg,
  .section-header-custom-floating .header__menu .header-color {
    color: var(--brand-heading);
  }
  @media screen and (min-width: 1025px) {
    .section-header-custom-floating .header__menu-toggle {
      display: none;
    }
    .section-header-custom-floating .header__menu {
      width: auto;
      order: 2;
    }
    .section-header-custom-floating .header__menu > nav {
      width: 100%;
      min-width: 0;
    }
    .section-header-custom-floating .horizontal-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
  }
  @media screen and (max-width: 1024px) {
    html.nav-open .section-header-custom-floating {
      z-index: 60;
    }
    html.nav-open body:has(.section-header-custom-floating) .section-announcement-bar,
    html.nav-open body:has(.section-header-custom-floating) #honeypop-app {
      visibility: hidden;
      pointer-events: none;
    }
    .section-header-custom-floating {
      --floating-header-gap: 8px;
      width: 100%;
    }
    .section-header-custom-floating .header__shell {
      width: 100%;
      border-radius: 16px;
      padding: 4px 7px;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .section-header-custom-floating .header__inner > div {
      width: 100%;
      max-width: none;
      padding-inline: var(--bs-gutter-x, 1.5rem);
    }
    .section-header-custom-floating .header__top-row {
      display: grid;
      --mobile-header-icon-size: 36px;
      grid-template-columns: var(--mobile-header-icon-size) minmax(0, 1fr) max-content;
      min-height: 48px;
      gap: 8px;
      padding: 0;
    }
    .section-header-custom-floating .header__menu {
      position: absolute;
      width: 0;
      min-width: 0;
      flex: 0 0 0;
      margin: 0;
      overflow: visible;
    }
    .section-header-custom-floating .header__menu > nav.horizontal:not(.mobile) {
      display: none !important;
    }
.section-header-custom-floating .header__menu-toggle {
      display: flex;
      margin: 0;
      grid-column: 1;
      grid-row: 1;
    }
    .section-header-custom-floating .header__menu-toggle .nav-toggle {
      justify-content: center;
    }
    .section-header-custom-floating .header__menu .navigation.mobile {
      z-index: 9999;
      overflow: visible;
      pointer-events: auto;
      top: 0 !important;
      bottom: 0 !important;
      height: 100dvh !important;
      max-height: 100dvh;
    }
    .section-header-custom-floating .header__menu .navigation.mobile .horizontal-list,
    .section-header-custom-floating .header__menu .navigation.mobile .submenu,
    .section-header-custom-floating .header__menu .navigation.mobile .submenu-horizontal,
    .section-header-custom-floating .header__menu .navigation.mobile .sub-children-menu {
      overflow: visible !important;
    }
    .section-header-custom-floating .header__menu .navigation.mobile .submenu-horizontal,
    .section-header-custom-floating .header__menu .navigation.mobile .sub-children-menu {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none !important;
      max-width: 100% !important;
      min-height: auto !important;
      z-index: auto !important;
      background: transparent !important;
      box-shadow: none !important;
      display: block !important;
    }
    .section-header-custom-floating .header__menu .navigation.mobile .submenu,
    .section-header-custom-floating .header__menu .navigation.mobile .sub-children-menu,
    .section-header-custom-floating .header__menu .navigation.mobile .submenu-horizontal {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      display: none !important;
    }
    .section-header-custom-floating .header__menu .navigation.mobile menu-item.is-open + .submenu-horizontal,
    .section-header-custom-floating .header__menu .navigation.mobile menu-item.is-open + .submenu,
    .section-header-custom-floating .header__menu .navigation.mobile menu-item.is-open + .sub-children-menu {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transform: none !important;
      position: relative !important;
      display: block !important;
    }
    .section-header-custom-floating .header__menu .navigation.mobile .sub-children-menu {
      padding-left: 1.5rem;
      padding-right: 1rem;
    }
    .section-header-custom-floating .header__logo {
      position: static;
      left: auto;
      transform: none;
      width: auto;
      flex: 1 1 auto;
      min-width: 0;
      overflow: visible;
      margin: 0;
      justify-content: center;
      grid-column: 2;
      grid-row: 1;
    }
    .section-header-custom-floating .header__logo :is(h1, .my-0, .logo-img, span.header__normal-logo) {
      min-width: 0;
      max-width: 100%;
    }
    .section-header-custom-floating .header__logo .logo-img {
      width: 100%;
      justify-content: center;
    }
    .section-header-custom-floating .header__logo span.header__normal-logo {
      width: var(--header-logo-width-mobile, 120px);
    }
    .section-header-custom-floating .header__logo img,
    .section-header-custom-floating .header__logo svg {
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }
    .section-header-custom-floating .header__action {
      gap: 0;
      margin: 0;
      flex: 0 0 auto;
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }
    .section-header-custom-floating .header__action > * {
      flex: 0 0 auto;
    }
    .section-header-custom-floating .header__action :is(.header_account, .header--icon, .header-icon, .top-search-toggle) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--mobile-header-icon-size);
      height: 44px;
      margin: 0;
      flex: 0 0 var(--mobile-header-icon-size);
    }
    .section-header-custom-floating #kp-login-button-header-logo,
    .section-header-custom-floating #icon-kwikpass {
      width: var(--mobile-header-icon-size);
      height: 44px;
      align-items: center;
      justify-content: center;
    }
  }
  @media screen and (max-width: 374px) {
    .section-header-custom-floating .header__top-row {
      --mobile-header-icon-size: 32px;
    }
  }
{%- endstyle -%}
<script src="{{ 'floating-shop-menu.js' | asset_url }}" defer></script>

<script src="{{ 'floating-header.js' | asset_url }}" defer="defer"></script>

<header
class="header relative section gradient remove_spacing color-{{ color_scheme }}{{ transparent_class }} popup-search-mobile"
  data-sticky="none"
  data-section-id="{{ section.id }}"
>
  <div class="header__inner">
    <div class="{{ section_width }}">
      <div class="header__shell">
        <header-inner class="logo-position header-middle align-center">
          <div class="header__top-row">
            <div class="header__menu-toggle">
              {%- render 'toggle-menu' -%}
            </div>
            <div class="header__logo text-center inline-flex align-center justify-center">
              {%- render 'logo', isTransparent: transparent -%}
            </div>
            <div class="header__menu">
              {% render 'floating-shop-menu' %}
              {%- liquid
                render 'horizontal-menu', class: 'min-h-1025-50', show_language: show_language
              -%}
