              <div class="lang__currency-desktop me-20 hidden flex-1025 gap-15">
                {% if show_language %}
                  {% render 'language-switcher' %}
                {% endif %}
                {% if show_country %}
                  {% render 'country-switcher' %}
                {% endif %}
              </div>
            {% endif %}
            {%- liquid
              if top_search
                render 'top-search-header'
              endif
              if my_account
                render 'my-account'
              endif
              if recently_viewed
                render 'recently-viewed'
              endif
              if wishlist
                render 'wishlist'
              endif
              if minicart and theme_st.enable_catalog_mode == false
                render 'minicart_header'
              endif
            -%}
            </div>
          </div>
        </header-inner>
      </div>
    </div>
  </div>
</header>

<script>
  // Establish the fixed-header offsets during parsing, before deferred theme scripts.
  (() => {
    const header = document.currentScript.closest('.section-header-custom-floating');
    if (!header) return;
    const announcementHeight = Array.from(document.querySelectorAll('.section-announcement-bar'))
      .reduce((height, bar) => height + bar.getBoundingClientRect().height, 0);
    document.documentElement.style.setProperty('--announcement-bar-height', `${announcementHeight}px`);
    document.documentElement.style.setProperty('--floating-header-height', `${header.getBoundingClientRect().height}px`);
  })();
</script>

{% schema %}
{
  "name": "Custom floating header",
  "class": "section-header section-header-custom-floating",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Custom floating header",
      "category": "Header"
    }
  ],
  "settings": [
    { "type": "link_list", "id": "shop_menu", "label": "Shop mega menu", "info": "Leave empty to use the main menu. Categories are arranged in three columns." },
    { "type": "image_picker", "id": "shop_menu_image", "label": "Shop mega menu image" },
    { "type": "url", "id": "shop_menu_image_link", "label": "Shop image link" },
    { "type": "text", "id": "shop_menu_image_heading", "label": "Shop image caption", "default": "Discover your next favourite" },
    {
      "type": "color",
      "id": "header_background",
      "label": "Floating header background",
      "default": "#f8f5f0"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {"value": "container", "label": "Container"},
        {"value": "fluid_container", "label": "Fluid container"},
        {"value": "stretch_width", "label": "Stretch width"},
        {"value": "full_width", "label": "Full width"}
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "default": "left",
      "label": "Logo position"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "default": false,
      "label": "Transparent header"
    },
    {
      "type": "link_list",
      "id": "mega_menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search"
    },
    {
      "type": "checkbox",
      "id": "show_account_icon",
      "default": true,
      "label": "Show account icon"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "default": false,
      "label": "Show recently viewed"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_icon",
      "default": false,
      "label": "Show wishlist icon"
    },
    {
      "type": "checkbox",
      "id": "show_shopping_cart",
      "default": true,
      "label": "Show cart"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "default": false,
      "label": "Show currency"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "default": false,
      "label": "Show language"
    }
  ]
}
{% endschema %}
