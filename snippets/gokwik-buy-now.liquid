
{% if settings.goBuynowEnable %}
  <button type="button" class="disabled" disabled onclick="onBuyNowClick(this)" id="gokwik-buy-now">
    {% comment %}GoKwik uses the first element child as its loading indicator.{% endcomment %}
    <div style="display:none" class="addloadr" id="btn-loader">
      <div class="cir-loader">Loading..</div>
    </div>
    <span class="gokwik-buy-now-label">
      <svg class="gokwik-buy-now-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M13.2 2 5 13h5.8L9.8 22 19 10.5h-6.2L13.2 2Z" fill="currentColor"/>
      </svg>
      {{ settings.buynow-titile }}
    </span>
    <span class="gokwik-buy-now-subtext">Pay Securely</span>

  </button>
{% endif %}



