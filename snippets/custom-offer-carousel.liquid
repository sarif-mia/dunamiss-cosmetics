<style>
  .dunamiss-offer-wrapper {
    font-family: var(--body-font);
    margin-bottom: 10px;
  }

  .dunamiss-offer-heading {
    font-size: 14px;
    font-weight: 600;
    color: #111;
    margin-bottom: 16px;
    padding: 5px 10px;
    border-radius: 12px;
    background: var(--brand-background);
    max-width: 450px;
  }

  .offer-carousel {
    font-size: 14px;
    font-weight: 600;
    color: #111;
    min-height: 20px;
    transition: opacity 0.4s ease-in-out;
  }

  .dunamiss-offer-section {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .dunamiss-offer-box {
    flex: 1 1 260px;
    max-width: 450px;
    background: var(--brand-background);
    border: 1px solid var(--brand-border);
    border-radius: 10px;
    padding: 8px 12px;
    transition: 0.3s ease;
  }

  .dunamiss-offer-title {
    font-size: 12px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }

  .dunamiss-offer-desc {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .dunamiss-offer-line {
    border-top: 1px solid #ccc;
    margin: 10px 0 8px;
  }

  .offer-condition {
    font-size: 12px;
    color: #777;
    font-style: italic;
    margin-top: 5px;
  }

  .copy-code-btn {
    background-color: #000;
    color: white;
    border: none;
    padding: 5px 10px;
    font-size: 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .copy-code-btn:hover {
    background-color: var(--brand-accent);
  }

  @media (max-width: 599px) {
    .dunamiss-offer-section {
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .dunamiss-offer-box {
      flex: 0 0 95%;
      min-width: 300px;
    }
  }
</style>

<div id="offer-carousel" class="dunamiss-offer-heading offer-carousel"></div>

<script>
  const messages = [
    "Shop for ₹299 and get free shipping.",
    "Shop for ₹1050 and get a free lip balm.",
    "Shop for ₹1599 and get a flat ₹250 OFF."
  ];

  let index = 0;
  const offerDiv = document.getElementById("offer-carousel");

  offerDiv.textContent = messages[index];

  setInterval(() => {
    index = (index + 1) % messages.length;
    offerDiv.style.opacity = 0;

    setTimeout(() => {
      offerDiv.textContent = messages[index];
      offerDiv.style.opacity = 1;
    }, 300);
  }, 3000);
  
  function copyPromoCode() {
    const promoCodeElement = document.getElementById("promo-code");
    const promoCode = promoCodeElement.innerText;
    
    navigator.clipboard.writeText(promoCode).then(function() {
      const originalText = document.querySelector('.copy-code-btn').innerText;
      document.querySelector('.copy-code-btn').innerText = "Copied!";
      
      setTimeout(function() {
        document.querySelector('.copy-code-btn').innerText = originalText;
      }, 2000);
    }).catch(function(error) {
      console.error('Failed to copy:', error);
      alert('Failed to copy promo code: ' + promoCode);
    });
  }
</script>
