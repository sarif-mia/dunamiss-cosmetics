<!-- offer-carousel + progress-bar -->
<style>
  .offer-train-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--body-font);
    gap: 12px;
    background: var(--brand-surface);
    margin-left: 5%;
    margin-right: 5%;
    width: 90%;
    border-radius: 10px;
  }

  .carousel-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 4px 10px;
    min-width: 44px;
    min-height: 44px;
    color:rgb(0, 0, 0);
    font-weight: bold;
    user-select: none;
  }

  .offer-text {
    font-size: 14px;
    white-space: normal;
    min-width: 0;
    flex: 1;
    line-height: 1.35;
    text-align: center;
  }

</style>
<!-- Gift offers use instance-scoped controls and do not poll the cart. -->
<gift-offer-carousel class="offer-train-wrapper" role="region" aria-label="Shipping and gift offers">
  <button type="button" class="carousel-btn left" data-offer-prev aria-label="Previous gift offer">‹</button>
  <span class="offer-text" data-offer-text aria-live="polite" aria-atomic="true">Free shipping and a free gift on prepaid orders</span>
  <button type="button" class="carousel-btn right" data-offer-next aria-label="Next gift offer">›</button>
</gift-offer-carousel>
<script>
  (() => {
    if (customElements.get('gift-offer-carousel')) return;
    customElements.define('gift-offer-carousel', class extends HTMLElement {
      connectedCallback() {
        this.controller?.abort();
        this.controller = new AbortController();
        this.index = 0;
        this.offers = ['Free shipping and a free gift on prepaid orders', 'Prepaid orders over ₹1,199 get a complimentary tote bag', 'COD convenience fee: ₹49'];
        const options = { signal: this.controller.signal };
        const bindControls = () => {
          const text = this.querySelector('[data-offer-text]');
          if (text) text.textContent = this.offers[this.index];
          this.querySelector('[data-offer-prev]')?.addEventListener('click', () => this.showOffer(-1), options);
          this.querySelector('[data-offer-next]')?.addEventListener('click', () => this.showOffer(1), options);
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindControls, { ...options, once: true });
        } else {
          queueMicrotask(bindControls);
        }
      }
      showOffer(direction) {
        this.index = (this.index + direction + this.offers.length) % this.offers.length;
        this.querySelector('[data-offer-text]').textContent = this.offers[this.index];
      }
      disconnectedCallback() { this.controller?.abort(); }
    });
  })();
</script>
