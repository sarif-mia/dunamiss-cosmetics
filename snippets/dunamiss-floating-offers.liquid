{{ 'dunamiss-floating-offers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dunamiss-floating-offers.js' | asset_url }}" defer></script>
{% liquid
  assign gift_product = settings.native_cart_gift_product
  assign gift_variant = gift_product.selected_or_first_available_variant
  assign shipping_threshold = settings.free_shipping_minimum | plus: 0
  assign gift_threshold = settings.native_cart_gift_threshold | plus: 0
  assign discount_threshold = settings.native_cart_discount_threshold | plus: 0
%}
<a class="dm-offers-fab" href="{{ pages['discount-offer'].url | default: '/pages/discount-offer' }}" data-dm-offers-open aria-label="View current offers and gifts" aria-haspopup="dialog">
  <svg width="48" height="48" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M12 29h40v27a3 3 0 0 1-3 3H15a3 3 0 0 1-3-3V29Z" fill="#d94c7a"/>
    <rect x="8" y="21" width="48" height="13" rx="3" fill="#ed7399"/>
    <path d="M28 21h8v38h-8z" fill="#ffe5a4"/>
    <path d="M31 21C10 23 13 4 23 9c6 3 8 12 8 12Zm2 0C54 23 51 4 41 9c-6 3-8 12-8 12Z" stroke="#e3ad53" stroke-width="5" stroke-linejoin="round"/>
    <path d="m7 9 1-4 1 4 4 1-4 1-1 4-1-4-4-1 4-1ZM55 12l1-3 1 3 3 1-3 1-1 3-1-3-3-1 3-1Z" fill="#e3ad53"/>
  </svg>
  <span>FREE</span>
</a>
<dialog class="dm-floating-offers" id="DmFloatingOffers" aria-labelledby="DmFloatingOffersTitle">
  <div class="dm-floating-offers__inner">
    <button class="dm-floating-offers__close" type="button" data-dm-offers-close aria-label="Close offers">×</button>
    <span class="dm-floating-offers__eyebrow">A little extra, just for you</span>
    <h2 id="DmFloatingOffersTitle">Your beauty rewards</h2>
    <p>Explore the offers available with your Dunamiss cart.</p>
    <ul class="dm-floating-offers__list">
      {% if settings.show_on_minicart_cart_page and shipping_threshold > 0 %}
        <li><span class="dm-floating-offers__number" aria-hidden="true">01</span><div><h3>Free shipping</h3><p>On qualifying orders from {{ shipping_threshold | times: 100 | money }}.</p></div></li>
      {% endif %}
      {% if settings.native_cart_auto_gift and gift_product != blank and gift_variant.available and gift_threshold > 0 %}
        <li>
          {% if gift_product.featured_image %}{{ gift_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: gift_product.title }}{% else %}<span class="dm-floating-offers__number" aria-hidden="true">02</span>{% endif %}
          <div><h3>A complimentary gift</h3><p>{{ gift_product.title | escape }} with qualifying orders from {{ gift_threshold | times: 100 | money }}. Added automatically, while stocks last.</p></div>
        </li>
      {% endif %}
      {% if settings.native_cart_discount_milestone and discount_threshold > 0 %}
        <li><span class="dm-floating-offers__number" aria-hidden="true">03</span><div><h3>{{ settings.native_cart_discount_label | default: 'Cart discount' | escape }}</h3><p>Unlock on qualifying orders from {{ discount_threshold | times: 100 | money }}.</p></div></li>
      {% endif %}
    </ul>
    <a class="dm-floating-offers__cta" href="{{ pages['discount-offer'].url | default: '/pages/discount-offer' }}">View all offers</a>
    <small>Final eligibility and savings are confirmed in your cart and at checkout.</small>
  </div>
</dialog>
