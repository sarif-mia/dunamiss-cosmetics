

{% if settings.envType == 'production' %}
  {% assign env = 'pdp' %}
{% elsif settings.envType == 'sandbox' %}
  {% assign env = 'sandbox.pdp' %}
{% endif %}

{% if settings.goEnable %}
  <script>
    window.gaTag = {ga4: "{{ settings.ga4Gokwik }}"}
    window.merchantInfo  = {
            mid: "{{ settings.mid }}",
            environment: "{{ settings.envType }}",
            type: "merchantInfo",
      		storeId: "{{shop.id}}",
      		fbpixel: "{{settings.fbpixel}}",
          }
    var productFormSelector = '';
    var cart = {{ cart | json }}
    var templateName = '{{template.name}}'
  </script>

  <script src="https://{{ env }}.gokwik.co/merchant-integration/build/merchant.integration.js?v4" defer></script>

  <script>
    window.addEventListener('gokwikLoaded', () => {
      const controls = '#gokwik-buy-now, .gokwik-checkout button';
      const relevantControls = controls + ", button[name='add']";
      const boundButtons = new WeakSet();
      const gokwikAdsID = {{ settings.gkAdsConfig | json }};
      let clicked = false;
      let pendingFrame = 0;

      function trackCheckout() {
        if (clicked || !gokwikAdsID) return;
        clicked = true;
        window.gtag?.('event', 'conversion', {
          'send_to': gokwikAdsID.toString().trim(),
          'value': {{ order.total_price | divided_by: 100.0 }},
          'currency': '{{ order.shop.currency }}',
          'transaction_id': '{{ order.order_number }}'
        });
      }

      function syncControls() {
        pendingFrame = 0;
        const addButton = document.querySelector("button[name='add']");
        document.querySelectorAll(controls).forEach((button) => {
          // Retain availability when variants update or the cart replaces its HTML.
          const disabled = button.id === 'gokwik-buy-now' && Boolean(addButton?.disabled);
          if (button.disabled !== disabled) button.disabled = disabled;
          button.classList.remove('disabled');
          if (gokwikAdsID && !boundButtons.has(button)) {
            button.addEventListener('click', trackCheckout);
            boundButtons.add(button);
          }
        });
      }

      function containsControl(node) {
        return node.nodeType === 1 &&
          (node.matches(relevantControls) || Boolean(node.querySelector(relevantControls)));
      }

      // Ignore review, video and other widget mutations. Only reconcile commerce
      // controls when they are inserted/removed or the add button changes stock state.
      const observer = new MutationObserver((records) => {
        const relevant = records.some((record) => {
          if (record.type === 'attributes') return record.target.matches("button[name='add']");
          return [...record.addedNodes, ...record.removedNodes].some(containsControl);
        });
        if (relevant && !pendingFrame) pendingFrame = requestAnimationFrame(syncControls);
      });
      observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['disabled']
      });
      gokwikSdk.on('modal_closed', () => { clicked = false; });
      syncControls();
    }, { once: true });
  </script>

{% endif %}

