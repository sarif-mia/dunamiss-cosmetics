{%- comment -%}Format existing ingredient data without rewriting formula names or claims.{%- endcomment -%}
{%- liquid
  assign ingredient_html = content | strip
  assign ingredient_markup = ingredient_html | downcase
  assign separator = '|||ingredient-line|||'
  if ingredient_markup contains '<br'
    assign ingredient_lines_text = ingredient_html | replace: '<br />', separator | replace: '<br/>', separator | replace: '<br>', separator | strip_html | strip_newlines
  else
    assign ingredient_lines_text = ingredient_html | strip_html | newline_to_br | replace: '<br />', separator
  endif
  assign ingredient_lines = ingredient_lines_text | split: separator
  assign paragraph_separator = separator | append: separator
  assign ingredient_groups = ingredient_lines_text | split: paragraph_separator
  assign group_count = 0
  for group in ingredient_groups
    assign group_text = group | remove: separator | strip
    if group_text != blank
      assign group_count = group_count | plus: 1
    endif
  endfor
  assign line_count = 0
  for line in ingredient_lines
    assign clean_line = line | strip
    if clean_line != blank
      assign line_count = line_count | plus: 1
    endif
  endfor
  assign ingredient_text = ingredient_html | strip_html | strip_newlines | strip
  assign ingredient_check = ingredient_text | downcase
  assign can_format_formula = false
  if ingredient_text contains ','
    if ingredient_text contains ', the formula is complemented by '
      assign can_format_formula = true
    else
      unless ingredient_check contains '. ' or ingredient_check contains ' helps ' or ingredient_check contains ' work together ' or ingredient_check contains ' designed to ' or ingredient_check contains ' is ' or ingredient_check contains ' for ' or ingredient_check contains ' while ' or ingredient_check contains ' with ' or ingredient_check contains ' to '
        assign can_format_formula = true
      endunless
    endif
  endif
-%}
{%- if ingredient_text != blank -%}
<div class="product-ingredients-content">
  {%- if ingredient_markup contains '<ul' or ingredient_markup contains '<ol' -%}
    {{ ingredient_html }}
  {%- elsif ingredient_lines_text contains '### ' -%}
    {%- assign product_groups = ingredient_lines_text | split: '### ' -%}
    {%- for group in product_groups -%}
      {%- assign group_lines = group | split: separator -%}
      {%- assign group_heading = group_lines.first | strip -%}
      {%- if group_heading != blank -%}
        <section class="product-ingredients-section">
          <h4>{{ group_heading | escape_once }}</h4>
          {%- capture group_content -%}
            {%- for line in group_lines offset: 1 -%}{{ line | escape_once }}<br />{%- endfor -%}
          {%- endcapture -%}
          {% render 'product-ingredients-list', content: group_content %}
        </section>
      {%- endif -%}
    {%- endfor -%}
  {%- elsif group_count > 1 and line_count > 1 -%}
    <div class="product-ingredients-cards">
      {%- for group in ingredient_groups -%}
        {%- assign group_lines = group | split: separator -%}
        {%- assign group_heading = group_lines.first | strip -%}
        {%- if group_heading != blank -%}
          <div class="product-ingredient-card">
            <h4>{{ group_heading | escape_once }}</h4>
            {%- for line in group_lines offset: 1 -%}
              {%- assign detail = line | strip -%}
              {%- if detail != blank -%}<p>{{ detail | escape_once }}</p>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- elsif line_count > 1 -%}
    <ul class="product-ingredients-list" role="list">
      {%- for line in ingredient_lines -%}
        {%- render 'product-ingredient-item', ingredient: line -%}
      {%- endfor -%}
    </ul>
  {%- elsif can_format_formula -%}
    {%- liquid
      assign ingredient_parts = ingredient_text | split: ', the formula is complemented by '
      assign key_text = ingredient_parts.first | remove_first: 'Enriched with '
      assign key_text = key_text | replace: '1,2-', '1__ingredient_comma__2-' | replace: '1,3-', '1__ingredient_comma__3-'
      assign key_ingredients = key_text | split: ','
    -%}
    <ul class="product-ingredients-list" role="list">
      {%- for ingredient in key_ingredients -%}
        {%- assign ingredient_name = ingredient | strip | remove_first: 'and ' | replace: '__ingredient_comma__', ',' -%}
        {%- render 'product-ingredient-item', ingredient: ingredient_name -%}
      {%- endfor -%}
    </ul>
    {%- if ingredient_parts.size > 1 -%}
      {%- liquid
        assign additional_text = ingredient_parts.last | split: ' to create ' | first
        assign additional_text = additional_text | replace: '1,2-', '1__ingredient_comma__2-' | replace: '1,3-', '1__ingredient_comma__3-'
        assign additional_ingredients = additional_text | split: ','
      -%}
      <h4 class="product-ingredients-subheading">Additional Ingredients</h4>
      <ul class="product-ingredients-list" role="list">
        {%- for ingredient in additional_ingredients -%}
          {%- assign ingredient_name = ingredient | strip | remove_first: 'and ' | replace: '__ingredient_comma__', ',' -%}
          {%- render 'product-ingredient-item', ingredient: ingredient_name -%}
        {%- endfor -%}
      </ul>
      {%- if ingredient_parts.last contains ' to create ' -%}
        <p class="product-ingredients-note">To create {{ ingredient_parts.last | split: ' to create ' | last | escape_once }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- else -%}
    <div class="product-ingredients-prose">{{ ingredient_html }}</div>
  {%- endif -%}
</div>
{%- endif -%}
