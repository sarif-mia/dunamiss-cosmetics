<style>
  .tested-trusted-button-wrap {
    display: flex;
    justify-content: flex-start;
    padding: 10px 10px 10px 0;
  }

  .tested-trusted-button {
    display: inline-block;
    margin: 0;
    background-color: var(--brand-border, #eadbe0);
    color: var(--brand-accent, #75465c);
    border: 1px solid var(--brand-accent, #75465c);
    border-radius: 4px;
    padding: 0.75rem 1.15rem;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .custom-icon-blocks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 20px 15px;
  }

  .custom-icon-block {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100px;
  }

  .custom-icon-block img {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .custom-icon-blocks {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 16px 10px;
    }

    .custom-icon-block {
      height: 80px;
    }

    .custom-icon-block img {
      width: 65px;
      height: 65px;
    }
  }
</style>

<div class="tested-trusted-button-wrap">
  <h2 class="tested-trusted-button">{% if content_settings != blank %}{{ content_settings.field_1 | escape }}{% else %}Tested and Trusted{% endif %}</h2>
</div>

<div class="custom-icon-blocks">
  <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_2 != blank %}{{ content_settings.field_2 | image_url: width: 1920 }}{% else %}{{ 'CLINICALLY_TESTED.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_3 | escape }}{% else %}Clinically Tested{% endif %}"
      width="70"
      height="70"
      loading="lazy"
    >
  </div>
  <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_4 != blank %}{{ content_settings.field_4 | image_url: width: 1920 }}{% else %}{{ 'SALFATE_PARABEN_FREE.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_5 | escape }}{% else %}Paraben Free{% endif %}"
      width="70"
      height="70"
      loading="lazy"
    >
  </div>
  <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_6 != blank %}{{ content_settings.field_6 | image_url: width: 1920 }}{% else %}{{ 'CRUELTY_FREE.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_7 | escape }}{% else %}Cruelty Free & Vegan{% endif %}"
      width="70"
      height="70"
      loading="lazy"
    >
  </div>
  <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_8 != blank %}{{ content_settings.field_8 | image_url: width: 1920 }}{% else %}{{ 'MADE_IN_INDIA_LOGO.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_9 | escape }}{% else %}Made In India{% endif %}"
      width="70"
      height="70"
      loading="lazy"
