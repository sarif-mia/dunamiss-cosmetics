  </div>
  <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_10 != blank %}{{ content_settings.field_10 | image_url: width: 1920 }}{% else %}{{ 'GMP_LOGO.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_11 | escape }}{% else %}GMP Certified{% endif %}"
      width="70"
