  </div>
   <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_12 != blank %}{{ content_settings.field_12 | image_url: width: 1920 }}{% else %}{{ 'VEGAN.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_13 | escape }}{% else %}GMP Certified{% endif %}"
      width="70"
      height="70"
      loading="lazy"
    >
  </div>
   <div class="custom-icon-block">
    <img
      src="{% if content_settings.field_14 != blank %}{{ content_settings.field_14 | image_url: width: 1920 }}{% else %}{{ 'tested_in_spain.png' | file_url }}{% endif %}"
      alt="{% if content_settings != blank %}{{ content_settings.field_15 | escape }}{% else %}GMP Certified{% endif %}"
      width="70"
