    border-radius: 4px;
    padding: 0.75rem 1.15rem;
    font-size: 14px;
    font-family: var(--body-font);
    font-weight: 600;
    line-height: 1.4;
}
.clinically-tested-certificates-carousel {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    position: relative;
}
.clinically-tested-title-arrow{
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}
.clinically-tested-carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.clinically-tested-carousel-btn {
    width: 42px;
    height: 42px;
    border: 1px solid #d6d6d6;
    background: #fff;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    color: #1a1a1a;
    transition: all 0.2s ease;
}

.clinically-tested-carousel-btn:hover {
    background: #f3f3f3;
}

.clinically-tested-certificates-grid {
    display: flex;
    overflow-x: auto;
    gap: 24px;
    align-items: stretch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 8px;
}

.clinically-tested-certificates-grid::-webkit-scrollbar {
    display: none;
}

.clinically-tested-certificate-item {
    text-align: center;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    padding-bottom: 16px;
    flex: 0 0 calc(24.8% - 16px);
    scroll-snap-align: start;
    border-radius: 8px;
}

.clinically-tested-certificate-item img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid var(--brand-accent);
}

.clinically-tested-certificate-item h3 {
    font-size: 14px;
    font-weight: 600;
    color: #000;
    margin: 0;
    padding: 0 8px;
}

@media(max-width:991px){
   .clinically-tested-certificate-item {
    flex: 0 0 calc(50% - 16px);
   }
   .clinically-tested-certified-quality-section {
	padding: 20px 0px;
   }
}
</style>
<!-- CERTIFIED QUALITY ASSURANCE SECTION -->
    <section class="clinically-tested-certified-quality-section">
