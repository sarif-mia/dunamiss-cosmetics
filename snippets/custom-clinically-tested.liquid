                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_1.settings.field_11 != blank %}{{ dm_content_1.settings.field_11 | image_url: width: 1920 }}{% else %}{{ 'On-Site_Inspection_Zurko.jpg' | file_url }}{% endif %}" alt="{{ dm_content_1.settings.field_12 | escape }}" width="250" height="350">
                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_1.settings.field_13 != blank %}{{ dm_content_1.settings.field_13 | image_url: width: 1920 }}{% else %}{{ 'Hazel_Glitter_Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_1.settings.field_14 | escape }}" width="250" height="350">
                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_1.settings.field_15 != blank %}{{ dm_content_1.settings.field_15 | image_url: width: 1920 }}{% else %}{{ 'Eye_Balm_Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_1.settings.field_16 | escape }}" width="250" height="350">
                    </div>
                     <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_1.settings.field_17 != blank %}{{ dm_content_1.settings.field_17 | image_url: width: 1920 }}{% else %}{{ 'Sunscreen_Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_1.settings.field_18 | escape }}" width="250" height="350">
                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_2.settings.field_19 != blank %}{{ dm_content_2.settings.field_19 | image_url: width: 1920 }}{% else %}{{ 'Lip_Oil_Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_2.settings.field_20 | escape }}" width="250" height="350" {{ dm_content_2.shopify_attributes }}>
                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_2.settings.field_21 != blank %}{{ dm_content_2.settings.field_21 | image_url: width: 1920 }}{% else %}{{ 'Am_Cream__Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_2.settings.field_22 | escape }}" width="250" height="350">
                    </div>
                    <div class="clinically-tested-certificate-item">
                        <img src="{% if dm_content_2.settings.field_23 != blank %}{{ dm_content_2.settings.field_23 | image_url: width: 1920 }}{% else %}{{ 'Mocka_Kiss_Certification.png' | file_url }}{% endif %}" alt="{{ dm_content_2.settings.field_24 | escape }}" width="250" height="350">
                    </div>
                </div>
            </div>
        </div>
    </section>
