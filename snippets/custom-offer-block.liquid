<style>
    /*==========================
    OFFER SECTION
==========================*/

    .available-offer-section {
        padding: 12px 0 16px;
    }

    .available-offer-box {
        max-width: 100%;
        margin: 0 auto;
        border: 1px solid #ececec;
        border-radius: 4px;
        background: #fff;
        overflow: hidden;
    }

    .available-offer-details {
        border: none;
    }

    .available-offer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 3px 15px;
        cursor: pointer;
    }

    .available-offer-header h2 {
        font-family: var(--body-font);
        font-size: 16px;
        font-weight: 700;
        color: #111;
        margin: 0;
    }

    .available-offer-toggle {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #111;
        font-size: 18px;
        transition: transform 0.25s ease;
    }

    .available-offer-toggle::before {
        content: "+";
        display: block;
        line-height: 1;
    }

    .available-offer-details[open] .available-offer-toggle::before {
        content: "-";
    }

    .available-offer-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        padding: 4px 16px 8px;
    }

    .available-offer-card {
        position: relative;
        padding: 8px 12px;
        border-radius: 16px;
        border: 1px dashed transparent;
        background: #fff;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 108px;
    }

    .available-offer-card::before {
        content: "";
        position: absolute;
        left: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 32px;
        background: #fff;
        border-radius: 0 16px 16px 0;
        border-top: 2px dashed transparent;
        border-bottom: 2px dashed transparent;
        box-shadow: inset 0 0 0 1px transparent;
    }

    .available-offer-card::after {
        content: "";
        position: absolute;
        right: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 32px;
        background: #fff;
        border-radius: 16px 0 0 16px;
        border-top: 2px dashed transparent;
        border-bottom: 2px dashed transparent;
        box-shadow: inset 0 0 0 1px transparent;
    }

    .available-offer-card.pink {
        background: var(--brand-background);
        border-color: var(--brand-border);
    }

    .available-offer-card.yellow {
        background: #fbf6dc;
        border-color: #e3bf5a;
    }

    .available-offer-icon {
        position: absolute;
        top: 4px;
        right: 16px;
        font-size: 16px;
    }

    .available-offer-card h3 {
        font-family: var(--body-font);
        font-size: 14px;
        line-height: 1.3;
        margin: 0 0 5px;
        color: #111;
    }

    .available-offer-card p {
        color: #555;
        font-size: 12px;
        line-height: 1.4;
        margin: 0 0 8px;
    }

    .available-offer-card a {
        font-size: 13px;
        font-weight: 700;
        color: #111;
        text-decoration: none;
        margin-top: auto;
    }

    .available-offer-card:hover a {
        color: var(--brand-accent);
    }

    @media (max-width: 991px) {
        .available-offer-grid {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            padding-bottom: 8px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            cursor: grab;
        }

        .available-offer-grid::-webkit-scrollbar {
            display: none;
        }

        .available-offer-grid:active {
            cursor: grabbing;
        }

        .available-offer-card {
            min-width: 230px;
            flex: 0 0 230px;
            scroll-snap-align: start;
        }
    }

    @media (max-width: 768px) {
        .available-offer-section {
            padding: 18px 0 24px;
        }

        .available-offer-header {
            padding: 16px 18px;
        }

        .available-offer-header h2 {
            font-size: 16px;
        }

        .available-offer-card {
            min-width: 220px;
            flex: 0 0 220px;
            padding: 10px 12px;
        }

        .available-offer-card h3 {
            font-size: 14px;
        }

        .available-offer-card p {
            margin: 0 0 4px;
        }

        .available-offer-card a {
            font-size: 13px;
        }
        .available-offer-icon {
        top: 10px;
        }
    }

    @media (max-width: 480px) {
        .available-offer-header {
            padding: 3px 16px;
        }

        .available-offer-header h2 {
            font-size: 16px;
        }
        .available-offer-content{
            padding: 0px 10px 5px 10px;
            margin-top: -8px;
        }
        .available-offer-grid {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            overflow-y: visible;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
            scroll-snap-type: x mandatory;
            padding: 4px 16px;
            cursor: grab;
        }
        .available-offer-card {
            min-width: 66%;
            flex: 0 0 72%;
            padding: 8px 12px;
        }

        .available-offer-card h3 {
            font-size: 14px;
            margin: 0 0 5px;
        }

        .available-offer-card p {
            font-size: 10px;
            max-width:86%;
        }

        .available-offer-card a {
            font-size: 12px;
        }
    }
</style>

