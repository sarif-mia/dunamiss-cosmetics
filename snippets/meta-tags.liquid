{%- liquid
  assign og_title = storefront_title | default: page_title | default: shop.name | remove: 'SEO Optimized Title: '
  assign og_url = storefront_canonical_url | default: canonical_url | default: request.origin
  assign og_type = 'website'
  assign social_image = page_image | default: settings.logo
  assign social_twitter = settings.twitter | default: settings.social_twitter_link
  assign social_image_width = social_image.width | default: 1200 | at_most: 1200
  assign social_image_ratio = social_image.aspect_ratio | default: 1
  assign social_image_height = social_image_width | divided_by: social_image_ratio | round
  assign og_description = storefront_description | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if social_image -%}
  <meta property="og:image" content="https:{{ social_image | image_url: width: social_image_width }}">
  <meta property="og:image:secure_url" content="https:{{ social_image | image_url: width: social_image_width }}">
  <meta property="og:image:width" content="{{ social_image_width }}">
  <meta property="og:image:height" content="{{ social_image_height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif -%}

{%- if social_twitter != blank -%}
  <meta name="twitter:site" content="{{ social_twitter | split: 'twitter.com/' | last | split: 'x.com/' | last | split: '?' | first | remove: '/' | prepend: '@' | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{% if social_image %}<meta name="twitter:image" content="https:{{ social_image | image_url: width: social_image_width }}">{% if social_image.alt != blank %}<meta property="og:image:alt" content="{{ social_image.alt | escape }}"><meta name="twitter:image:alt" content="{{ social_image.alt | escape }}">{% endif %}{% endif %}
