{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sales-timer-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    background: {{ block.settings.background_gradient }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.text_alignment }};
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-sales-timer-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-sales-timer-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-sales-timer-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    line-height: 1.2;
  }

  .ai-sales-timer-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.9;
  }

  .ai-sales-timer-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.timer_alignment }};
    gap: {{ block.settings.timer_gap }}px;
    flex-wrap: wrap;
    margin-bottom: {{ block.settings.timer_bottom_spacing }}px;
  }

  .ai-sales-timer-unit-{{ ai_gen_id }} {
    background: {{ block.settings.timer_background }};
    border: {{ block.settings.timer_border_width }}px solid {{ block.settings.timer_border_color }};
    border-radius: {{ block.settings.timer_border_radius }}px;
    padding: {{ block.settings.timer_padding }}px;
    min-width: {{ block.settings.timer_min_width }}px;
    box-shadow: {{ block.settings.timer_shadow }};
    transition: transform 0.3s ease;
  }

  .ai-sales-timer-unit-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-sales-timer-number-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: 4px;
  }

  .ai-sales-timer-label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: {{ block.settings.label_transform }};
    font-weight: {{ block.settings.label_weight }};
  }

  .ai-sales-timer-message-{{ ai_gen_id }} {
    color: {{ block.settings.message_color }};
    font-size: {{ block.settings.message_size }}px;
    margin: 0;
    padding: {{ block.settings.message_padding }}px;
    background: {{ block.settings.message_background }};
    border-radius: {{ block.settings.message_border_radius }}px;
    display: none;
  }

  .ai-sales-timer-message-{{ ai_gen_id }}.show {
    display: block;
  }

  .ai-sales-timer-expired-{{ ai_gen_id }} {
    color: {{ block.settings.expired_color }};
    font-size: {{ block.settings.expired_size }}px;
    font-weight: {{ block.settings.expired_weight }};
    margin: 0;
    display: none;
  }

  .ai-sales-timer-expired-{{ ai_gen_id }}.show {
    display: block;
  }

  .ai-sales-timer-not-started-{{ ai_gen_id }} {
    color: {{ block.settings.not_started_color }};
    font-size: {{ block.settings.not_started_size }}px;
    margin: 0;
    display: none;
  }

  .ai-sales-timer-not-started-{{ ai_gen_id }}.show {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-sales-timer-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-sales-timer-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-sales-timer-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }

    .ai-sales-timer-countdown-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_timer_gap }}px;
      justify-content: {{ block.settings.mobile_timer_alignment }};
    }

    .ai-sales-timer-unit-{{ ai_gen_id }} {
      min-width: {{ block.settings.mobile_timer_min_width }}px;
      padding: {{ block.settings.mobile_timer_padding }}px;
    }

    .ai-sales-timer-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_number_size }}px;
    }

    .ai-sales-timer-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_label_size }}px;
    }
  }

  {% if block.settings.show_pulse_effect %}
    @keyframes ai-pulse-{{ ai_gen_id }} {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .ai-sales-timer-unit-{{ ai_gen_id }}.pulse {
      animation: ai-pulse-{{ ai_gen_id }} 1s ease-in-out infinite;
    }
  {% endif %}
{% endstyle %}

<sales-countdown-timer-{{ ai_gen_id }}
  class="ai-sales-timer-{{ ai_gen_id }}"
  data-start-time="{{ block.settings.sale_start_time }}"
  data-end-time="{{ block.settings.sale_end_time }}"
  data-timezone="{{ block.settings.timezone }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sales-timer-content-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-sales-timer-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-sales-timer-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-sales-timer-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-sales-timer-countdown-{{ ai_gen_id }}" id="countdown-{{ ai_gen_id }}">
      {% if block.settings.show_days %}
        <div class="ai-sales-timer-unit-{{ ai_gen_id }}">
          <span class="ai-sales-timer-number-{{ ai_gen_id }}" data-unit="days">00</span>
          <span class="ai-sales-timer-label-{{ ai_gen_id }}">{{ block.settings.days_label }}</span>
        </div>
      {% endif %}
      
      {% if block.settings.show_hours %}
        <div class="ai-sales-timer-unit-{{ ai_gen_id }}">
          <span class="ai-sales-timer-number-{{ ai_gen_id }}" data-unit="hours">00</span>
          <span class="ai-sales-timer-label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</span>
        </div>
      {% endif %}
      
      {% if block.settings.show_minutes %}
        <div class="ai-sales-timer-unit-{{ ai_gen_id }}">
          <span class="ai-sales-timer-number-{{ ai_gen_id }}" data-unit="minutes">00</span>
          <span class="ai-sales-timer-label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</span>
        </div>
      {% endif %}
      
      {% if block.settings.show_seconds %}
        <div class="ai-sales-timer-unit-{{ ai_gen_id }}">
          <span class="ai-sales-timer-number-{{ ai_gen_id }}" data-unit="seconds">00</span>
          <span class="ai-sales-timer-label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</span>
        </div>
      {% endif %}
    </div>

    {% if block.settings.sale_message != blank %}
      <p class="ai-sales-timer-message-{{ ai_gen_id }}" id="sale-message-{{ ai_gen_id }}">
        {% if block.settings.sale_message_link != blank %}
          <a href="{{ block.settings.sale_message_link }}" style="color: inherit; text-decoration: none;">
            {{ block.settings.sale_message }}
          </a>
        {% else %}
          {{ block.settings.sale_message }}
        {% endif %}
      </p>
    {% endif %}

    {% if block.settings.expired_message != blank %}
      <p class="ai-sales-timer-expired-{{ ai_gen_id }}" id="expired-message-{{ ai_gen_id }}">
        {{ block.settings.expired_message }}
      </p>
    {% endif %}

    {% if block.settings.not_started_message != blank %}
      <p class="ai-sales-timer-not-started-{{ ai_gen_id }}" id="not-started-message-{{ ai_gen_id }}">
        {{ block.settings.not_started_message }}
      </p>
    {% endif %}
  </div>
</sales-countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class SalesCountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.startTime = this.dataset.startTime;
        this.endTime = this.dataset.endTime;
        this.timezone = this.dataset.timezone || 'UTC';
        this.interval = null;
        this.isActive = false;
      }

      connectedCallback() {
        this.initTimer();
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      initTimer() {
        this.countdownElement = this.querySelector('#countdown-{{ ai_gen_id }}');
        this.saleMessageElement = this.querySelector('#sale-message-{{ ai_gen_id }}');
        this.expiredMessageElement = this.querySelector('#expired-message-{{ ai_gen_id }}');
        this.notStartedMessageElement = this.querySelector('#not-started-message-{{ ai_gen_id }}');
        
        this.daysElement = this.querySelector('[data-unit="days"]');
        this.hoursElement = this.querySelector('[data-unit="hours"]');
        this.minutesElement = this.querySelector('[data-unit="minutes"]');
        this.secondsElement = this.querySelector('[data-unit="seconds"]');
      }

      parseDateTime(dateTimeString) {
        if (!dateTimeString) return null;
        
        const date = new Date(dateTimeString);
        return isNaN(date.getTime()) ? null : date;
      }

      getCurrentTime() {
        return new Date();
      }

      startCountdown() {
        this.updateTimer();
        this.interval = setInterval(() => {
          this.updateTimer();
        }, 1000);
      }

      updateTimer() {
        const now = this.getCurrentTime();
        const startTime = this.parseDateTime(this.startTime);
        const endTime = this.parseDateTime(this.endTime);

        if (!endTime) {
          this.showExpired();
          return;
        }

        if (startTime && now < startTime) {
          this.showNotStarted();
          this.calculateTimeRemaining(startTime, now);
          return;
        }

        if (now >= endTime) {
          this.showExpired();
          return;
        }

        this.showActive();
        this.calculateTimeRemaining(endTime, now);
      }

      calculateTimeRemaining(targetTime, currentTime) {
        const timeDiff = targetTime.getTime() - currentTime.getTime();
        
        if (timeDiff <= 0) {
          this.showExpired();
          return;
        }

        const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((timeDiff % (1000 * 60)) / 1000);

        this.updateDisplay(days, hours, minutes, seconds);
        
        {% if block.settings.show_pulse_effect %}
          if (timeDiff <= 60000) {
            this.addPulseEffect();
          }
        {% endif %}
      }

      updateDisplay(days, hours, minutes, seconds) {
        if (this.daysElement) {
          this.daysElement.textContent = this.padZero(days);
        }
        if (this.hoursElement) {
          this.hoursElement.textContent = this.padZero(hours);
        }
        if (this.minutesElement) {
          this.minutesElement.textContent = this.padZero(minutes);
        }
        if (this.secondsElement) {
          this.secondsElement.textContent = this.padZero(seconds);
        }
      }

      padZero(num) {
        return num.toString().padStart(2, '0');
      }

      showActive() {
        if (this.countdownElement) this.countdownElement.style.display = 'flex';
        if (this.saleMessageElement) this.saleMessageElement.classList.add('show');
        if (this.expiredMessageElement) this.expiredMessageElement.classList.remove('show');
        if (this.notStartedMessageElement) this.notStartedMessageElement.classList.remove('show');
        this.isActive = true;
      }

      showExpired() {
        if (this.countdownElement) this.countdownElement.style.display = 'none';
        if (this.saleMessageElement) this.saleMessageElement.classList.remove('show');
        if (this.expiredMessageElement) this.expiredMessageElement.classList.add('show');
        if (this.notStartedMessageElement) this.notStartedMessageElement.classList.remove('show');
        
        if (this.interval) {
          clearInterval(this.interval);
        }
        this.isActive = false;
      }

      showNotStarted() {
        if (this.countdownElement) this.countdownElement.style.display = 'flex';
        if (this.saleMessageElement) this.saleMessageElement.classList.remove('show');
        if (this.expiredMessageElement) this.expiredMessageElement.classList.remove('show');
        if (this.notStartedMessageElement) this.notStartedMessageElement.classList.add('show');
        this.isActive = false;
      }

      addPulseEffect() {
        const units = this.querySelectorAll('.ai-sales-timer-unit-{{ ai_gen_id }}');
        units.forEach(unit => {
          unit.classList.add('pulse');
        });
      }
    }

    customElements.define('sales-countdown-timer-{{ ai_gen_id }}', SalesCountdownTimer{{ ai_gen_id }});
  })();
</script>

